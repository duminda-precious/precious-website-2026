---
/**
 * FaqSection: heading in cols 1–3, questions in cols 4–12 (from lg); stacks below.
 * Props: heading, items.
 * Tokens: --text-statement, --tracking-heading, --leading-heading, --space-*.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../primitives/Section.astro';
import Grid12 from '../primitives/Grid12.astro';
import GridItem from '../primitives/GridItem.astro';
import Disclosure from '../ui/Disclosure.astro';

interface Props {
  heading: string;
  items: CollectionEntry<'faq'>[];
}
const { heading, items } = Astro.props;
---

<Section id="faq" labelledby="faq-title">
  <Grid12 class="faq">
    <GridItem span={3}>
      <h2 id="faq-title" class="faq__heading">
        {heading}
      </h2>
    </GridItem>
    <GridItem span={9} start={4}>
      {items.map(({ data }) => (
        <Disclosure question={data.question} answer={data.answer} />
      ))}
    </GridItem>
  </Grid12>
</Section>

<style>
  @layer components {
    .faq {
      row-gap: var(--space-24);
    }
    .faq__heading {
      font-size: var(--text-statement);
      letter-spacing: var(--tracking-heading);
      line-height: var(--leading-heading);
    }
  }
</style>
