---
/**
 * ClientsSection: three-zone header (statement + Clutch rating), the testimonial
 * marquee (M4), the client name row, and a centred Book a call.
 * Marquee: cards render twice for a seamless loop (the copy is aria-hidden + inert);
 * CSS runs it (--dur-marquee, linear); it pauses on hover, focus, the visible
 * pause button (WCAG 2.2.2) and when off-screen (src/motion/marquee.ts).
 * Reduced motion: no animation; the row scrolls sideways with scroll-snap.
 * Props: heading, testimonials, clients.
 * Tokens: --gutter, --marquee-gap, --dur-marquee, --ease-linear, --space-*, --text-secondary.
 * Motion hooks: data-motion="marquee", data-marquee-toggle.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import Pill from '../ui/Pill.astro';
import Button from '../ui/Button.astro';
import TestimonialCard from './TestimonialCard.astro';
import { bookCall } from '../../config/navigation';
import { site } from '../../config/site';
import { ui } from '../../config/ui';

interface Props {
  heading: string;
  testimonials: CollectionEntry<'testimonials'>[];
  clients: CollectionEntry<'clients'>[];
}
const { heading, testimonials, clients } = Astro.props;
const stars = '★'.repeat(Math.round(site.clutchRating));
---

<Section id="clients" labelledby="clients-title">
  <SectionHeader headingId="clients-title">
    {heading}
    <Pill slot="action">
      <span aria-hidden="true">
        {ui.rating.source} {stars} {site.clutchRating}
      </span>
      <span class="visually-hidden">
        {ui.rating.srLabel(site.clutchRating, site.clutchRatingMax)}
      </span>
    </Pill>
  </SectionHeader>

  <div class="marquee" data-motion="marquee">
    <div class="marquee__track">
      <div class="marquee__set">
        {testimonials.map(({ data }) => (
          <TestimonialCard testimonial={data} />
        ))}
      </div>
      <div class="marquee__set marquee__set--copy" aria-hidden="true" inert>
        {testimonials.map(({ data }) => (
          <TestimonialCard testimonial={data} />
        ))}
      </div>
    </div>
  </div>
  <div class="marquee__controls">
    <Pill
      as="button"
      aria-pressed="false"
      data-marquee-toggle
      data-label-pause={ui.marquee.pause}
      data-label-play={ui.marquee.play}
    >
      {ui.marquee.pause}
    </Pill>
  </div>

  <ul class="client-names" aria-label={ui.clientsListLabel}>
    {clients.map(({ data: c }) => (
      <li>{c.name}</li>
    ))}
  </ul>

  <div class="clients__cta">
    <Button href={bookCall.href} track={bookCall.track}>
      {bookCall.label}
    </Button>
  </div>
</Section>

<style>
  @layer components {
    /* Full bleed: cancel the section gutter. */
    .marquee {
      margin-inline: calc(var(--gutter) * -1);
      overflow: hidden;
    }
    .marquee__track {
      display: flex;
      gap: var(--marquee-gap);
      width: max-content;
      animation: marquee var(--dur-marquee) var(--ease-linear) infinite;
    }
    .marquee__set {
      display: flex;
      gap: var(--marquee-gap);
    }
    @keyframes marquee {
      to {
        transform: translateX(calc(-50% - var(--marquee-gap) / 2));
      }
    }
    .marquee:hover .marquee__track,
    .marquee:focus-within .marquee__track,
    .marquee[data-paused] .marquee__track,
    .marquee[data-offscreen] .marquee__track {
      animation-play-state: paused;
    }
    .marquee__controls {
      display: flex;
      justify-content: flex-end;
      margin-top: var(--space-16);
    }

    /* Reduced motion: a swipeable row instead of a moving one. */
    @media (prefers-reduced-motion: reduce) {
      .marquee {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding-inline: var(--gutter);
      }
      .marquee__track {
        animation: none;
        padding-inline: var(--gutter);
      }
      .marquee__set > :global(*) {
        scroll-snap-align: start;
      }
      .marquee__set--copy,
      .marquee__controls {
        display: none;
      }
    }

    .client-names {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-24);
      margin-block: var(--space-56);
      list-style: none;
      color: var(--text-secondary);
    }
    .clients__cta {
      display: flex;
      justify-content: center;
    }
  }
</style>
