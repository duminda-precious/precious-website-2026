---
/**
 * ClientsSection (Claude Design): "What Working with Us Feels Like."
 * Header: statement with the Clutch rating directly under it; Book a call top-right.
 * Slider (M9): a full-bleed horizontal scroll-snap row of testimonial cards that loops
 * endlessly (three copies; it re-centres on the middle copy when scrolling settles)
 * and advances one card every --dur-autoplay, pausing on hover, focus, a hidden tab,
 * and under reduced motion. ← → IconButtons move one card; on hover their arrow glitches.
 * Props: heading, testimonials.
 * Tokens: --gutter, --slide-gap, --space-*.
 * Motion hooks: data-motion="slider", data-slider-track, data-slider-prev/-next, data-slide-copy.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import Pill from '../ui/Pill.astro';
import IconButton from '../ui/IconButton.astro';
import Button from '../ui/Button.astro';
import TestimonialCard from './TestimonialCard.astro';
import { bookCall } from '../../config/navigation';
import { site } from '../../config/site';
import { ui } from '../../config/ui';

interface Props {
  heading: string;
  testimonials: CollectionEntry<'testimonials'>[];
}
const { heading, testimonials } = Astro.props;
const stars = '★'.repeat(Math.round(site.clutchRating));
const copies = [0, 1, 2];
---

<Section id="clients" labelledby="clients-title">
  <SectionHeader headingId="clients-title">
    {heading}
    <Pill slot="meta">
      <span aria-hidden="true">
        {ui.rating.source} {stars} {site.clutchRating}
      </span>
      <span class="visually-hidden">
        {ui.rating.srLabel(site.clutchRating, site.clutchRatingMax)}
      </span>
    </Pill>
    <Button slot="action" href={bookCall.href} track={bookCall.track} cta>
      {bookCall.label}
    </Button>
  </SectionHeader>

  <div class="slider" data-motion="slider">
    <ul class="slider__track" aria-label={ui.slider.label} tabindex="0" data-slider-track>
      {copies.map((copy) =>
        testimonials.map(({ data }) => (
          <li
            class="slider__slide"
            aria-hidden={copy === 1 ? undefined : 'true'}
            inert={copy === 1 ? undefined : true}
            data-slide-copy={copy}
          >
            <TestimonialCard testimonial={data} />
          </li>
        )),
      )}
    </ul>
    <div class="slider__controls">
      <IconButton icon="arrow-left" label={ui.slider.prev} data-slider-prev />
      <IconButton icon="arrow-right" label={ui.slider.next} data-slider-next />
    </div>
  </div>
</Section>

<style>
  @layer components {
    /* Full bleed, one card per page, next card peeks. */
    .slider {
      margin-inline: calc(var(--gutter) * -1);
    }
    .slider__track {
      display: flex;
      gap: var(--slide-gap);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scroll-behavior: smooth;
      scrollbar-width: none;
    }
    .slider__track::-webkit-scrollbar {
      display: none;
    }
    .slider__slide {
      flex: none;
      scroll-snap-align: start;
    }
    .slider__controls {
      display: flex;
      justify-content: flex-end;
      gap: var(--space-8);
      margin-top: var(--space-16);
      padding-inline: var(--gutter);
    }
    @media (prefers-reduced-motion: reduce) {
      .slider__track {
        scroll-behavior: auto;
      }
    }
  }
</style>
