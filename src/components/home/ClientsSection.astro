---
/**
 * ClientsSection: three-zone header (statement + Clutch rating), the testimonial
 * slider, the client logo ticker, and a centred Book a call.
 * Slider (M9): a horizontal scroll-snap row, one card per "page" with the next
 * peeking; swipe/trackpad natively, or the ← → buttons (src/motion/slider.ts).
 * Ticker (M4/M8): client names loop continuously, full bleed. The list renders
 * twice for a seamless loop (the copy is aria-hidden + inert). Pauses on hover,
 * focus and off-screen; stops under reduced motion (then wraps as a static row).
 * Props: heading, testimonials, clients.
 * Tokens: --gutter, --slide-gap, --ticker-gap, --dur-marquee, --ease-linear, --space-*,
 *         --border-strong, --radius-pill, --tap-min, --text-large, --text-secondary.
 * Motion hooks: data-motion="slider", data-motion="marquee".
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import Pill from '../ui/Pill.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import Button from '../ui/Button.astro';
import TestimonialCard from './TestimonialCard.astro';
import { bookCall } from '../../config/navigation';
import { site } from '../../config/site';
import { ui } from '../../config/ui';

interface Props {
  heading: string;
  testimonials: CollectionEntry<'testimonials'>[];
  clients: CollectionEntry<'clients'>[];
}
const { heading, testimonials, clients } = Astro.props;
const stars = '★'.repeat(Math.round(site.clutchRating));
---

<Section id="clients" labelledby="clients-title">
  <SectionHeader headingId="clients-title">
    {heading}
    <Pill slot="action">
      <span aria-hidden="true">
        {ui.rating.source} {stars} {site.clutchRating}
      </span>
      <span class="visually-hidden">
        {ui.rating.srLabel(site.clutchRating, site.clutchRatingMax)}
      </span>
    </Pill>
  </SectionHeader>

  <div class="slider" data-motion="slider">
    <ul
      class="slider__track"
      aria-label={ui.slider.label}
      tabindex="0"
      data-slider-track
      data-lenis-prevent-wheel
    >
      {testimonials.map(({ data }) => (
        <li class="slider__slide">
          <TestimonialCard testimonial={data} />
        </li>
      ))}
    </ul>
    <div class="slider__controls">
      <button class="slider__arrow" type="button" aria-label={ui.slider.prev} data-slider-prev>
        <PixelIcon name="arrow-left" size="lg" />
      </button>
      <button class="slider__arrow" type="button" aria-label={ui.slider.next} data-slider-next>
        <PixelIcon name="arrow-right" size="lg" />
      </button>
    </div>
  </div>

  <div class="ticker" data-motion="marquee">
    <div class="ticker__track">
      <ul class="ticker__set" aria-label={ui.clientsListLabel}>
        {clients.map(({ data: c }) => (
          <li>{c.name}</li>
        ))}
      </ul>
      <ul class="ticker__set ticker__set--copy" aria-hidden="true" inert>
        {clients.map(({ data: c }) => (
          <li>{c.name}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="clients__cta">
    <Button href={bookCall.href} track={bookCall.track}>
      {bookCall.label}
    </Button>
  </div>
</Section>

<style>
  @layer components {
    /* ---- Slider: full bleed, one card per page ---- */
    .slider {
      margin-inline: calc(var(--gutter) * -1);
    }
    .slider__track {
      display: flex;
      gap: var(--slide-gap);
      padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      list-style: none;
    }
    .slider__track::-webkit-scrollbar {
      display: none;
    }
    .slider__slide {
      flex: none;
      scroll-snap-align: start;
    }
    .slider__controls {
      display: flex;
      justify-content: flex-end;
      gap: var(--space-8);
      margin-top: var(--space-16);
      padding-inline: var(--gutter);
    }
    .slider__arrow {
      display: inline-grid;
      place-items: center;
      width: var(--tap-min);
      height: var(--tap-min);
      border: var(--border-width) solid var(--border-strong);
      border-radius: var(--radius-pill);
      font-size: var(--text-large);
      line-height: var(--leading-none);
    }
    .slider__arrow:hover:not(:disabled) {
      opacity: var(--hover-opacity);
    }
    .slider__arrow:disabled {
      opacity: var(--disabled-opacity);
      cursor: default;
    }

    /* ---- Ticker: continuous logo loop, full bleed ---- */
    .ticker {
      margin: var(--space-56) calc(var(--gutter) * -1);
      overflow: hidden;
    }
    .ticker__track {
      display: flex;
      gap: var(--ticker-gap);
      width: max-content;
      animation: ticker var(--dur-marquee) var(--ease-linear) infinite;
    }
    .ticker__set {
      display: flex;
      gap: var(--ticker-gap);
      list-style: none;
      color: var(--text-secondary);
      white-space: nowrap;
    }
    @keyframes ticker {
      to {
        transform: translateX(calc(-50% - var(--ticker-gap) / 2));
      }
    }
    .ticker:hover .ticker__track,
    .ticker:focus-within .ticker__track,
    .ticker[data-offscreen] .ticker__track {
      animation-play-state: paused;
    }
    @media (prefers-reduced-motion: reduce) {
      .ticker {
        margin-inline: 0;
      }
      .ticker__track {
        width: auto;
        animation: none;
      }
      .ticker__set {
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-24);
        width: 100%;
      }
      .ticker__set--copy {
        display: none;
      }
    }

    .clients__cta {
      display: flex;
      justify-content: center;
    }
  }
</style>
