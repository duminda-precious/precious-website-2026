---
/**
 * TeamSection (Claude Design, funnel option 2a): "One Team Instead of Five Hires."
 * Centred heading + subline, then the funnel, capped at --team-max and centred:
 *   five role chips → the Personalised AI Engine → the five outputs.
 * A pixel flow (canvas, motion/teamFlow.ts) streams in from the roles, narrows into
 * the engine and fans out to the outputs, with brighter accent cells stepping along
 * it. Entrance: the engine appears, the chips pop out of it and slide into place,
 * then the flow draws in; afterwards a gentle pulse loops every few seconds and each
 * output chip lights up (gradient edge glow) as the flow reaches it.
 * Two stages share the markup: horizontal from md, vertical (roles on top) below.
 * Props: heading, subline, roles, engine, outputs.
 * Tokens: --team-*, --wash-rim, --wash-edge, --wash-hub, --blur-halo, --blur-glow,
 *         --text-note, --text-medium, --leading-tight, --radius-xs, --space-*.
 * Header: SectionHeader (centred).
 * Motion hooks: data-flow (layout h|v), data-role, data-out, data-chip, data-cc,
 *               data-engine, data-core, data-wash, data-ring (motion/teamFlow.ts).
 */
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { ui } from '../../config/ui';

interface Props {
  heading: string;
  subline: string;
  roles: string[];
  engine: string;
  outputs: string[];
}
const { heading, subline, roles, engine, outputs } = Astro.props;
const stages = ['h', 'v'] as const;
---

<Section id="team" labelledby="team-title">
  <SectionHeader headingId="team-title" align="center">
    {heading}
    <Fragment slot="sub">{subline}</Fragment>
  </SectionHeader>

  <div class="team__wrap">
    {stages.map((layout) => (
      <div class:list={['flow', `flow--${layout}`]} data-flow data-layout={layout} aria-hidden={layout === 'v' ? 'true' : undefined}>
        <canvas class="flow__canvas" aria-hidden="true"></canvas>
        <ul class="flow__col flow__col--roles" aria-label={layout === 'h' ? ui.team.roles : undefined}>
          {roles.map((r) => (
            <li class="flow__chip" data-role>{r}</li>
          ))}
        </ul>
        <div class="flow__engine" data-engine>
          <span class="flow__ring" data-ring></span>
          <span class="flow__core" data-core>
            <span class="flow__wash" data-wash></span>
          </span>
          <p class="flow__label">{engine}</p>
        </div>
        <ul class="flow__col flow__col--outs" aria-label={layout === 'h' ? ui.team.outputs : undefined}>
          {outputs.map((o) => (
            <li class="flow__out" data-out>
              <span class="flow__chip" data-chip><span class="flow__cc" data-cc>{o}</span></span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>

<style>
  @layer components {
    .team__wrap {
      max-width: var(--team-max);
      margin: 0 auto;
    }

    .flow {
      position: relative;
      height: var(--team-height);
      overflow: visible;
    }
    .flow--v {
      display: none;
      height: var(--team-height-v);
    }
    @media (max-width: 47.49rem) {
      .flow--h {
        display: none;
      }
      .flow--v {
        display: block;
      }
    }
    .flow__canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .flow__col {
      position: absolute;
      display: flex;
      flex-wrap: wrap;
      align-content: center;
      gap: var(--space-10);
    }
    .flow--h .flow__col {
      top: 0;
      bottom: 0;
      width: min(var(--team-col-max), var(--team-col-share));
      min-width: var(--team-col-min);
    }
    .flow--h .flow__col--roles {
      left: var(--team-inset);
    }
    .flow--h .flow__col--outs {
      right: var(--team-inset);
      justify-content: flex-end;
    }
    /* Phones: the vertical stage is full bleed so the flow spills past the side
       padding to the screen edges; the chips stay inside the padding. */
    .flow--v {
      margin-inline: calc(var(--gutter) * -1);
    }
    .flow--v .flow__col {
      left: var(--gutter);
      right: var(--gutter);
      height: var(--team-v-block);
      justify-content: center;
    }
    .flow--v .flow__col--roles {
      top: var(--team-v-roles-top);
    }
    .flow--v .flow__col--outs {
      top: var(--team-v-outs-top);
    }
    .flow__chip {
      position: relative;
      display: flex;
      align-items: center;
      min-height: var(--team-chip-height);
      padding: var(--space-8) var(--space-18);
      border-radius: var(--radius-xs);
      background: var(--team-chip-bg);
      box-shadow: var(--team-chip-shadow);
      color: var(--team-chip-fg);
      white-space: nowrap;
    }
    .flow__out {
      position: relative;
      isolation: isolate;
    }
    .flow__out .flow__chip {
      transform: scale(var(--team-chip-rest-scale));
    }
    .flow__cc {
      opacity: var(--team-chip-dim);
    }

    .flow__engine {
      --hub: var(--team-hub-size);
      position: absolute;
      left: calc(50% - var(--hub) / 2);
      top: calc(50% - var(--hub) / 2);
      display: grid;
      place-items: center;
      width: var(--hub);
      height: var(--hub);
      border-radius: 50%;
      color: var(--team-hub-fg);
      text-align: center;
      isolation: isolate;
    }
    .flow--v .flow__engine {
      --hub: var(--team-hub-size-sm);
      top: var(--team-v-engine-top);
    }
    .flow__ring {
      position: absolute;
      inset: calc(var(--space-8) * -1);
      border-radius: 50%;
      opacity: 0;
      pointer-events: none;
      background: var(--wash-rim);
      mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    }
    .flow__core {
      position: absolute;
      inset: 0;
      overflow: hidden;
      border-radius: 50%;
      background: var(--team-hub-bg);
    }
    .flow__wash {
      position: absolute;
      inset: -30%;
      opacity: var(--team-hub-wash);
      background: var(--wash-hub);
    }
    .flow__label {
      position: relative;
      max-width: calc(var(--hub) * var(--team-label-share));
      font-family: var(--font-display);
      font-size: var(--text-note);
      line-height: var(--leading-tight);
      text-wrap: balance;
    }
    .flow--v .flow__label {
      font-size: var(--text-medium);
    }
  }
</style>
