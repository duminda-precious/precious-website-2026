---
/**
 * TeamSection: centred heading + subline (prototype). The diagram itself is a
 * placeholder until the phase-2 design (decision 2026-09-29); its data stays in
 * home.json (team.coreRoles, extendedRoles, engine, benefits).
 * Props: heading, subline, placeholder.
 * Tokens: --text-statement, --tracking-heading, --leading-heading, --measure-statement,
 *         --text-medium, --leading-medium, --text-tertiary, --header-gap.
 */
import Section from '../primitives/Section.astro';
import MediaFrame from '../ui/MediaFrame.astro';

interface Props {
  heading: string;
  subline: string;
  placeholder: string;
}
const { heading, subline, placeholder } = Astro.props;
---

<Section id="team" labelledby="team-title">
  <div class="team__header">
    <h2 id="team-title" class="team__heading">
      {heading}
    </h2>
    <p class="team__sub">{subline}</p>
  </div>
  <MediaFrame aspect="16/9" label={placeholder} />
</Section>

<style>
  @layer components {
    .team__header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-12);
      margin-bottom: var(--header-gap);
      text-align: center;
    }
    .team__heading {
      max-width: var(--measure-statement);
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-statement);
      letter-spacing: var(--tracking-heading);
      line-height: var(--leading-heading);
    }
    .team__sub {
      max-width: var(--measure-subline);
      font-size: var(--text-medium);
      line-height: var(--leading-medium);
      color: var(--text-tertiary);
    }
  }
</style>
