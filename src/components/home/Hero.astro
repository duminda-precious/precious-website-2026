---
/**
 * Hero (Claude Design): two states.
 *   Rest    the two-line title over the showreel, which is blurred and covered by a
 *           white veil (--hero-veil), so it reads as a soft moving gradient. Words
 *           glitch on hover and at random; the news stack sits bottom-left.
 *   Reveal  the first scroll is held while the title glitches out word by word, the
 *           veil lifts and the reel comes into focus; then the page scrolls normally
 *           and the reel shrinks into the section padding with rounded corners.
 *           Scrolling back up inside the hero returns to rest.
 * The real title text stays in the DOM (the pixels are a canvas overlay).
 * Props: headline (lines), reel, news.
 * Tokens: --text-hero, --tracking-hero, --leading-hero, --hero-fg, --hero-veil-bg,
 *         --hero-veil, --blur-reel-max, --nav-height, --gutter, --z-raised, --z-float,
 *         --dur-veil, --ease-standard, --pill-solid-bg/-fg, --text-label, --space-*.
 * Motion hooks: data-hero, data-hero-reel, data-hero-video, data-hero-veil,
 *               data-hero-title, data-hero-sound (motion/heroReveal.ts), NewsStack.
 */
import NewsStack from './NewsStack.astro';
import { ui } from '../../config/ui';

interface NewsItem {
  title: string;
  body: string;
  cta: string;
  href: string;
  tint: 'sky' | 'lavender' | 'rose' | 'mint' | 'neutral';
}
interface Props {
  headline: string[];
  reel: { video?: string; poster?: string; alt: string; placeholderLabel: string };
  news: NewsItem[];
}
const { headline, reel, news } = Astro.props;
---

<header id="hero" class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__reel" data-hero-reel>
    {reel.video && (
      <video
        class="hero__video"
        src={reel.video}
        poster={reel.poster}
        muted
        playsinline
        loop
        autoplay
        aria-label={reel.alt}
        data-hero-video
      />
    )}
    <div class="hero__veil" data-hero-veil></div>
    {reel.video && (
      <button
        class="hero__sound"
        type="button"
        aria-pressed="false"
        data-label-on={ui.reel.soundOn}
        data-label-off={ui.reel.soundOff}
        data-hero-sound
        data-motion="sound-toggle"
        tabindex="-1"
      >
        {ui.reel.soundOn}
      </button>
    )}
  </div>

  <div class="hero__center">
    <h1 id="hero-title" class="hero__title" data-hero-title>
      {headline.map((line) => (
        <span class="hero__line">{line}</span>
      ))}
    </h1>
  </div>

  <NewsStack items={news} />
</header>

<style>
  @layer components {
    .hero {
      position: relative;
      height: 100vh;
      margin-top: calc(var(--nav-height) * -1);
      color: var(--hero-fg);
    }
    .hero__reel {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }
    /* Oversized so the blur has no soft edges. */
    .hero__video {
      position: absolute;
      inset: calc(var(--blur-reel-max) * -1);
      width: calc(100% + var(--blur-reel-max) * 2);
      height: calc(100% + var(--blur-reel-max) * 2);
      object-fit: cover;
      filter: blur(calc(var(--hero-veil) * var(--blur-reel-max)));
      transition: filter var(--dur-veil) var(--ease-standard);
    }
    .hero__veil {
      position: absolute;
      inset: 0;
      background: var(--hero-veil-bg);
      opacity: var(--hero-veil);
      transition: opacity var(--dur-veil) var(--ease-standard);
    }
    .hero[data-revealed] .hero__video {
      filter: none;
    }
    .hero[data-revealed] .hero__veil {
      opacity: 0;
    }
    .hero__sound {
      position: absolute;
      right: var(--space-16);
      bottom: var(--space-16);
      z-index: var(--z-raised);
      display: inline-flex;
      align-items: center;
      padding: var(--space-10) var(--space-14);
      border-radius: var(--radius-pill);
      background: var(--pill-solid-bg);
      color: var(--pill-solid-fg);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur-base) var(--ease-standard);
    }
    .hero[data-revealed] .hero__sound {
      opacity: 1;
      pointer-events: auto;
    }
    .hero__center {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 var(--gutter);
      text-align: center;
      pointer-events: none;
    }
    .hero__title {
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-hero);
      letter-spacing: var(--tracking-hero);
      line-height: var(--leading-hero);
    }
    .hero__line {
      display: block;
      white-space: nowrap;
    }
    .hero__title :global(.px) {
      pointer-events: auto;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero__video,
      .hero__veil,
      .hero__sound {
        transition: none;
      }
    }
  }
</style>
