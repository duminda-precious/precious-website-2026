---
/**
 * WorkSection: the dark stage. Three-zone header with "See our work" as a regular
 * button (Claude Design), then the position-based grid (src/config/layout.ts) of
 * ContentCards: 1 column on phones, 2 from md, 12 from lg with spans by position.
 * The case video plays in the card; "View case study" expands from the corner on hover.
 * Cards rise in row by row (M3).
 * Props: heading, subline, seeAll (label, href), items (home work entries in order).
 * Tokens: --grid-gap-row, --grid-gap-col, --grid-columns.
 * Motion hooks: data-theme-stage="dark" via Section (M2), data-motion="rise-in" (M3).
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import Button from '../ui/Button.astro';
import ContentCard from '../ui/ContentCard.astro';
import { workGridPositions } from '../../config/layout';
import { situationLabels } from '../../config/taxonomy';
import { ui } from '../../config/ui';

interface Props {
  heading: string;
  subline: string;
  seeAll: { label: string; href: string };
  items: CollectionEntry<'work'>[];
}
const { heading, subline, seeAll, items } = Astro.props;
---

<Section id="work" theme="dark" surface stage labelledby="work-title">
  <SectionHeader headingId="work-title">
    {heading}
    <Fragment slot="sub">{subline}</Fragment>
    <Button slot="action" href={seeAll.href} cta>{seeAll.label}</Button>
  </SectionHeader>

  <ul class="work-grid">
    {items.map((entry, i) => {
      const pos = workGridPositions[i] ?? workGridPositions[workGridPositions.length - 1]!;
      return (
        <li class="work-grid__item" style={`--work-span: ${pos.span}`} data-motion="rise-in">
          <ContentCard
            href={`/work/${entry.id}`}
            tag={situationLabels[entry.data.tag]}
            title={entry.data.title}
            summary={entry.data.summary}
            cta={ui.viewCaseStudy}
            video={entry.data.media.video}
            poster={entry.data.media.poster}
            alt={entry.data.media.alt}
            placeholder={entry.data.media.placeholderLabel}
            aspect={pos.aspect.replace('/', ' / ')}
            seed={i}
          />
        </li>
      );
    })}
  </ul>
</Section>

<style>
  @layer components {
    .work-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--grid-gap-row) var(--grid-gap-col);
      align-items: start;
    }
    @media (min-width: 47.5rem) {
      .work-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (min-width: 62rem) {
      .work-grid {
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      }
      .work-grid__item {
        grid-column: span var(--work-span);
      }
    }
  }
</style>
