---
/**
 * NewsStack (Claude Design): mini news / trust cards, bottom-left of the hero.
 * Frosted-glass cards (thumbnail, title, two-line description, square arrow link)
 * stacked like a deck: the front card, and two more peeking below it with only their
 * glass showing. Every --dur-autoplay the front card lifts up and fades out while the
 * others slide forward. Pauses on hover and keyboard focus; the wheel over the stack
 * flips cards (down = next, up = previous; the page doesn't scroll from there);
 * swipe on touch. Hides with the title when the hero reveals.
 * Props: items ({ title, body, cta, href, tint }).
 * Tokens: --news-width/-height/-thumb/-peek/-scale-step/-fade-*, --news-thumb-*, --glass-bg,
 *         --glass-saturate, --blur-glass, --icon-button,
 *         --radius-md, --radius-sm, --text-body, --text-small, --text-micro,
 *         --leading-snug, --text-secondary, --placeholder-fg, --gutter, --z-float,
 *         --dur-collapse, --dur-stack-fade, --dur-base, --ease-out-expo, --ease-standard.
 * Motion hooks: data-news, data-news-card, data-rel (motion/newsStack.ts).
 */
import IconButton from '../ui/IconButton.astro';
import { ui } from '../../config/ui';

interface Props {
  items: { title: string; body: string; cta: string; href: string; tint: string }[];
}
const { items } = Astro.props;
const n = items.length;
const rel = (k: number) => (k === 0 ? '0' : k === 1 ? '1' : k === 2 ? '2' : k === n - 1 ? 'last' : 'rest');
---

<div class="news" data-news aria-roledescription="carousel" aria-label={ui.news.label} style={`--news-count: ${n}`}>
  {items.map((c, k) => (
    <article
      class="news__card"
      data-news-card
      data-rel={rel(k)}
      aria-hidden={k === 0 ? undefined : 'true'}
      style={`--news-z: ${k === n - 1 ? n + 1 : n - k}`}
    >
      <div class="news__thumb type-overline" style={`--news-tint: var(--news-thumb-${c.tint})`}>
        <span>{ui.news.thumb}</span>
      </div>
      <div class="news__text">
        <h3 class="news__title">{c.title}</h3>
        <p class="news__body">{c.body}</p>
      </div>
      <IconButton
        icon="arrow-right"
        label={c.cta}
        href={c.href}
        class="news__link"
        tabindex={k === 0 ? undefined : '-1'}
      />
    </article>
  ))}
</div>

<style>
  @layer components {
    .news {
      position: absolute;
      left: var(--gutter);
      right: var(--gutter);
      bottom: calc(var(--gutter) + var(--space-16));
      z-index: var(--z-float);
      max-width: var(--news-width);
      height: var(--news-height);
      transition:
        opacity var(--dur-stack-fade) var(--ease-standard),
        transform var(--dur-collapse) var(--ease-out-expo);
    }
    :global([data-revealed]) .news {
      opacity: 0;
      transform: translateY(var(--space-12));
      pointer-events: none;
    }
    .news__card {
      position: absolute;
      inset: auto 0 0;
      height: var(--news-height);
      display: grid;
      grid-template-columns: var(--news-thumb) minmax(0, 1fr) var(--icon-button);
      align-items: stretch;
      gap: var(--space-12);
      padding: var(--space-10);
      border-radius: var(--radius-md);
      background: var(--glass-bg);
      backdrop-filter: blur(var(--blur-glass)) saturate(var(--glass-saturate));
      -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(var(--glass-saturate));
      transform-origin: 50% 100%;
      z-index: var(--news-z);
      transition:
        transform var(--dur-collapse) var(--ease-out-expo),
        opacity var(--dur-stack-fade) var(--ease-standard);
    }
    /* Deck positions (set by newsStack.ts; the markup starts on card 1). */
    .news__card[data-rel='0'] {
      transform: none;
      opacity: 1;
    }
    .news__card[data-rel='1'] {
      transform: translateY(var(--news-peek)) scale(calc(1 - var(--news-scale-step)));
      opacity: var(--news-fade-1);
    }
    .news__card[data-rel='2'] {
      transform: translateY(calc(var(--news-peek) * 2)) scale(calc(1 - var(--news-scale-step) * 2));
      opacity: var(--news-fade-2);
    }
    /* The card that just left lifts up and fades. */
    .news__card[data-rel='last'] {
      transform: translateY(calc(var(--news-peek) * -1.75)) scale(calc(1 + var(--news-scale-step) / 3));
      opacity: 0;
    }
    .news__card[data-rel='rest'] {
      transform: translateY(calc(var(--news-peek) * 3)) scale(calc(1 - var(--news-scale-step) * 3));
      opacity: 0;
    }
    .news__card:not([data-rel='0']) {
      pointer-events: none;
    }
    /* Cards behind show only their glass. */
    .news__thumb,
    .news__text,
    .news__card :global(.news__link) {
      transition: opacity var(--dur-base) var(--ease-standard);
    }
    .news__card:not([data-rel='0']) .news__thumb,
    .news__card:not([data-rel='0']) .news__text,
    .news__card:not([data-rel='0']) :global(.news__link) {
      opacity: 0;
    }
    .news__thumb {
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-sm);
      background: var(--news-tint);
      font-size: var(--text-micro);
      color: var(--placeholder-fg);
    }
    .news__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-4);
      min-width: 0;
    }
    .news__title {
      font-family: var(--font-sans);
      font-size: var(--text-body);
      font-weight: var(--weight-label);
      line-height: var(--leading-snug);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .news__body {
      font-size: var(--text-small);
      line-height: var(--leading-compact);
      color: var(--text-secondary);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .news__card :global(.news__link) {
      align-self: end;
    }
    /* Phones: full width at the bottom. */
    @media (max-width: 47.49rem) {
      .news {
        max-width: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .news,
      .news__card,
      .news__thumb,
      .news__text {
        transition: none;
      }
    }
  }
</style>
