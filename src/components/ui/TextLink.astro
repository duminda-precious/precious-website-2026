---
/**
 * TextLink: underlined arrow link ("View case study →", "Meet the AI Design Agent →").
 * Also covers the uppercase "SEE OUR WORK →" style via variant="caps".
 * The arrow is decorative (aria-hidden) so screen readers hear the label only.
 * Props: href, variant 'underline' | 'caps', size 'sm' | 'md', arrow (default true),
 *        track (→ data-track, e.g. "case-study"), external, class.
 * Tokens: --text-ui, --text-body-sm, --text-caption, --tracking-caps, --border-width.
 * Motion hooks: none (global hover opacity).
 */
interface Props {
  href: string;
  variant?: 'underline' | 'caps';
  size?: 'sm' | 'md';
  arrow?: boolean;
  track?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  href,
  variant = 'underline',
  size = 'md',
  arrow = true,
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['text-link', `text-link--${variant}`, `text-link--${size}`, className]}
  data-track={track}
  {...externalAttrs}
  {...rest}
>
  <slot />
  {arrow && <span aria-hidden="true"> →</span>}
</a>

<style>
  @layer components {
    .text-link {
      display: inline-block;
      align-self: flex-start;
    }
    .text-link--underline {
      border-bottom: var(--border-width) solid currentColor;
    }
    .text-link--underline.text-link--md {
      font-size: var(--text-ui);
    }
    .text-link--underline.text-link--sm {
      font-size: var(--text-body-sm);
    }
    .text-link--caps {
      font-size: var(--text-caption);
      letter-spacing: var(--tracking-caps);
      text-transform: uppercase;
    }
  }
</style>
