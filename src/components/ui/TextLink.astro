---
/**
 * TextLink: exploration links, not CTAs.
 *   variant 'underline' → sans, underlined, with → ("View case study →", "Meet the AI Design Agent →")
 *   variant 'label'     → UI link in the Label style ("See our work →")
 * The arrow is decorative (aria-hidden) so screen readers hear the label only.
 * Props: href, variant, arrow (default true), track (→ data-track, e.g. "case-study"), external, class.
 * Tokens: --text-body, --text-label, --font-sans, --tracking-label, --border-width.
 * Motion hooks: none (global hover opacity).
 */
interface Props {
  href: string;
  variant?: 'underline' | 'label';
  arrow?: boolean;
  track?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  href,
  variant = 'underline',
  arrow = true,
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['text-link', `text-link--${variant}`, className]}
  data-track={track}
  {...externalAttrs}
  {...rest}
>
  <slot />
  {arrow && <span aria-hidden="true"> →</span>}
</a>

<style>
  @layer components {
    .text-link {
      display: inline-block;
      align-self: flex-start;
    }
    .text-link--underline {
      font-size: var(--text-body);
      border-bottom: var(--border-width) solid currentColor;
    }
    .text-link--label {
      font-family: var(--font-sans);
      font-weight: var(--weight-semibold);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      line-height: var(--leading-none);
    }
  }
</style>
