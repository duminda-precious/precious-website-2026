---
/**
 * TextLink: exploration links, not CTAs.
 *   variant 'underline' → sans, underlined, with → ("View case study →", "Meet the AI Design Agent →")
 *   variant 'label'     → UI link in the Label style ("See our work →")
 *   variant 'plain'     → body text, no underline, arrow first ("→ Senior people join…")
 * The arrow is decorative (aria-hidden) so screen readers hear the label only.
 * Props: href, variant, arrow (default true), track (→ data-track, e.g. "case-study"), external, class.
 * Tokens: --text-body, --text-label, --font-sans, --tracking-label, --border-width.
 * Motion hooks: none (global hover opacity).
 */
import PixelIcon from './PixelIcon.astro';
interface Props {
  href: string;
  variant?: 'underline' | 'label' | 'plain';
  arrow?: boolean;
  track?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  href,
  variant = 'underline',
  arrow = true,
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={['text-link', `text-link--${variant}`, { 'type-label': variant === 'label' }, className]}
  data-track={track}
  {...externalAttrs}
  {...rest}
>
  {arrow && variant === 'plain' && <PixelIcon name="arrow-right" class="text-link__lead" />}
  <slot />
  {arrow && variant !== 'plain' && <PixelIcon name="arrow-right" class="text-link__arrow" />}
</a>

<style>
  @layer components {
    .text-link :global(.text-link__arrow) {
      margin-left: var(--space-8);
    }
    .text-link {
      display: inline-block;
      align-self: flex-start;
    }
    .text-link--underline {
      font-size: var(--text-body);
      border-bottom: var(--border-width) solid currentColor;
    }
    .text-link--plain {
      display: inline-flex;
      align-items: center;
      gap: var(--space-8);
    }
  }
</style>
