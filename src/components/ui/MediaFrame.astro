---
/**
 * MediaFrame: video, image, or the prototype's striped placeholder, at a locked
 * aspect ratio so media never shifts layout.
 *
 * Props:
 *   aspect  one of mediaAspects ('3/2', '5/4', '1/1', '4/3', '16/9', …) | 'fill'
 *           ('fill' stretches to the parent, used by gate cards)
 *   tone    'auto'   → stripes follow the section theme (light / dark / ink)
 *           'gradient' → brand gradient + grain (gate cards; parent sets --mf-gradient)
 *           'logo'   → testimonial logo slot (finer stripes)
 *   label   placeholder text (Eyebrow style), e.g. "case video"
 *   video, poster       → <video muted playsinline loop preload="none">
 *   image, alt          → string URL or an astro:assets import
 *   rounded (default true), class
 *   default slot        → overlays positioned inside the frame (e.g. sound pill)
 *
 * Tokens: --placeholder-stripe-a/b, --placeholder-fg, --gate-media-fg, --grain-*, --logo-stripe-*,
 *         --stripe-size, --stripe-size-sm, --radius-md, --font-sans, --text-eyebrow.
 * Motion hooks: data-motion="video-in-view" on <video> (M7).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MediaAspect } from './media';

interface Props {
  aspect?: MediaAspect | 'fill';
  tone?: 'auto' | 'gradient' | 'logo';
  label?: string;
  video?: string;
  poster?: string;
  image?: string | ImageMetadata;
  alt?: string;
  rounded?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  aspect = '16/9',
  tone = 'auto',
  label,
  video,
  poster,
  image,
  alt = '',
  rounded = true,
  class: className,
  ...rest
} = Astro.props;
const isPlaceholder = !video && !image;
const style = aspect === 'fill' ? undefined : `--media-aspect: ${aspect}`;
---

<div
  class:list={[
    'media-frame',
    `media-frame--${tone}`,
    {
      'media-frame--fill': aspect === 'fill',
      'media-frame--rounded': rounded,
      'media-frame--placeholder': isPlaceholder,
    },
    className,
  ]}
  style={style}
  {...rest}
>
  {video ? (
    <video
      class="media-frame__media"
      src={video}
      poster={poster}
      muted
      playsinline
      loop
      preload="none"
      data-motion="video-in-view"
      aria-label={alt || undefined}
    />
  ) : image ? (
    typeof image === 'string' ? (
      <img class="media-frame__media" src={image} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <Image class="media-frame__media" src={image} alt={alt} />
    )
  ) : (
    label && <span class="media-frame__label">{label}</span>
  )}
  <slot />
</div>

<style>
  @layer components {
    .media-frame {
      --mf-a: var(--placeholder-stripe-a);
      --mf-b: var(--placeholder-stripe-b);
      --mf-fg: var(--placeholder-fg);
      --mf-stripe: var(--stripe-size);

      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      aspect-ratio: var(--media-aspect);
      overflow: hidden;
    }
    /* Brand gradient placeholder (gate cards). The parent sets --mf-gradient. */
    .media-frame--gradient {
      --mf-fg: var(--gate-media-fg);
    }
    .media-frame--gradient.media-frame--placeholder {
      background: var(--mf-gradient);
    }
    .media-frame--gradient.media-frame--placeholder::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--grain-image);
      opacity: var(--grain-opacity);
      mix-blend-mode: multiply;
      pointer-events: none;
    }
    .media-frame--logo {
      --mf-a: var(--logo-stripe-a);
      --mf-b: var(--logo-stripe-b);
      --mf-fg: var(--placeholder-fg);
      --mf-stripe: var(--stripe-size-sm);
    }
    .media-frame--fill {
      flex: 1;
      min-height: 0;
      aspect-ratio: auto;
    }
    .media-frame--rounded {
      border-radius: var(--radius-md);
    }
    .media-frame--placeholder {
      background: repeating-linear-gradient(
        45deg,
        var(--mf-a) 0 var(--mf-stripe),
        var(--mf-b) var(--mf-stripe) calc(var(--mf-stripe) * 2)
      );
    }
    .media-frame__label {
      font-family: var(--font-sans);
      font-weight: var(--weight-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
      font-size: var(--text-eyebrow);
      color: var(--mf-fg);
    }
    .media-frame__media {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
