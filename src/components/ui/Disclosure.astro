---
/**
 * Disclosure: one FAQ item on native <details>/<summary> (M6). The "+" turns 45°
 * when open. src/motion/disclosure.ts animates the height open and closed in
 * every browser; without JS (or with reduced motion) it opens instantly.
 * Props: question, answer.
 * Tokens: --border-default, --space-*, --tap-min, --text-body, --leading-body,
 *         --text-secondary, --text-large, --dur-fast, --ease-standard.
 * Motion hooks: data-motion="disclosure", data-disclosure-content, data-closing.
 */
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="disclosure" data-motion="disclosure">
  <summary class="disclosure__summary">
    <span>{question}</span>
    <span class="disclosure__icon" aria-hidden="true">
      +
    </span>
  </summary>
  <div class="disclosure__content" data-disclosure-content>
    <p class="disclosure__answer">{answer}</p>
  </div>
</details>

<style>
  @layer components {
    .disclosure {
      border-bottom: var(--border-width) solid var(--border-default);
    }
    .disclosure__summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-16);
      min-height: var(--tap-min);
      padding-block: var(--space-18);
      font-size: var(--text-body);
    }
    .disclosure__icon {
      flex: none;
      font-size: var(--text-large);
      line-height: var(--leading-none);
      transition: transform var(--dur-fast) var(--ease-standard);
    }
    /* Rotate while open; during an animated close it turns back straight away. */
    .disclosure[open]:not([data-closing]) .disclosure__icon {
      transform: rotate(45deg);
    }
    .disclosure__content {
      overflow: hidden;
    }
    .disclosure__answer {
      padding-bottom: var(--space-18);
      line-height: var(--leading-body);
      color: var(--text-secondary);
    }
    @media (prefers-reduced-motion: reduce) {
      .disclosure__icon {
        transition: none;
      }
    }
  }
</style>
