---
/**
 * Disclosure: one FAQ item on native <details>/<summary> (M6). The pixel "+" swaps
 * to a pixel "×" when open. src/motion/disclosure.ts animates the height open and closed in
 * every browser; without JS (or with reduced motion) it opens instantly.
 * Props: question, answer.
 * Tokens: --border-default, --space-*, --tap-min, --text-body, --leading-body,
 *         --text-secondary, --pixel-unit-lg.
 * Motion hooks: data-motion="disclosure", data-disclosure-content, data-closing.
 */
import PixelIcon from './PixelIcon.astro';
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="disclosure" data-motion="disclosure">
  <summary class="disclosure__summary">
    <span>{question}</span>
    <span class="disclosure__icon" aria-hidden="true">
      <PixelIcon name="plus" size="lg" class="disclosure__plus" />
      <PixelIcon name="close" size="lg" class="disclosure__close" />
    </span>
  </summary>
  <div class="disclosure__content" data-disclosure-content>
    <p class="disclosure__answer">{answer}</p>
  </div>
</details>

<style>
  @layer components {
    .disclosure {
      border-bottom: var(--border-width) solid var(--border-default);
    }
    .disclosure__summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-16);
      min-height: var(--tap-min);
      padding-block: var(--space-18);
      font-size: var(--text-body);
    }
    .disclosure__icon {
      display: inline-flex;
      flex: none;
    }
    /* Pixel icons don't rotate cleanly, so + swaps to × while open (a hard,
       8-bit switch). During an animated close it turns back straight away. */
    .disclosure__icon :global(.disclosure__close),
    .disclosure[open]:not([data-closing]) .disclosure__icon :global(.disclosure__plus) {
      display: none;
    }
    .disclosure[open]:not([data-closing]) .disclosure__icon :global(.disclosure__close) {
      display: inline-block;
    }
    .disclosure__content {
      overflow: hidden;
    }
    .disclosure__answer {
      padding-bottom: var(--space-18);
      line-height: var(--leading-body);
      color: var(--text-secondary);
    }
    @media (prefers-reduced-motion: reduce) {
      .disclosure__icon {
        transition: none;
      }
    }
  }
</style>
