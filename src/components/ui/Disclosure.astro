---
/**
 * Disclosure: one FAQ item on native <details>/<summary> (M6). The "+" turns 45°
 * when open. The height animates where ::details-content + interpolate-size are
 * supported; elsewhere it opens instantly.
 * Props: question, answer.
 * Tokens: --border-default, --space-*, --tap-min, --text-body, --leading-body,
 *         --text-secondary, --text-large, --dur-fast, --ease-standard.
 */
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="disclosure">
  <summary class="disclosure__summary">
    <span>{question}</span>
    <span class="disclosure__icon" aria-hidden="true">
      +
    </span>
  </summary>
  <p class="disclosure__answer">{answer}</p>
</details>

<style>
  @layer components {
    .disclosure {
      padding-block: var(--space-18);
      border-bottom: var(--border-width) solid var(--border-default);
    }
    .disclosure__summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-16);
      min-height: var(--tap-min);
      font-size: var(--text-body);
    }
    .disclosure__icon {
      flex: none;
      font-size: var(--text-large);
      line-height: var(--leading-none);
      transition: transform var(--dur-fast) var(--ease-standard);
    }
    .disclosure[open] .disclosure__icon {
      transform: rotate(45deg);
    }
    .disclosure__answer {
      margin-top: var(--space-10);
      line-height: var(--leading-body);
      color: var(--text-secondary);
    }
    @supports (interpolate-size: allow-keywords) {
      .disclosure {
        interpolate-size: allow-keywords;
      }
      .disclosure::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size var(--dur-base) var(--ease-standard),
          content-visibility var(--dur-base) allow-discrete;
      }
      .disclosure[open]::details-content {
        block-size: auto;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .disclosure__icon,
      .disclosure::details-content {
        transition: none;
      }
    }
  }
</style>
