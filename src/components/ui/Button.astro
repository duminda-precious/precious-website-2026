---
/**
 * Button: Label-style text (Funnel Sans 600, sentence case) and a pixel ▸ glyph, 12px corners.
 * One solid style site-wide; its colours come from the theme (--cta-bg/--cta-fg),
 * so it is Deep Ink on light sections and inverse on dark ones. The gradient +
 * pixel hover (--cta-hover-*) arrives in P2-4. Renders <a> when href is set, otherwise <button>.
 * Props:
 *   size  'sm' (nav) | 'md'
 *   glyph show the ▸ (default true)
 *   href, type, track (→ data-track, e.g. "book-call"), external, class
 * Tokens: --cta-bg, --cta-fg, --radius-md, --font-sans, --text-label, --tracking-label,
 *         --space-*, --tap-min, --hover-opacity.
 * Motion hooks: none (hover is the global opacity token, M9).
 */
import PixelIcon from './PixelIcon.astro';
interface Props {
  size?: 'sm' | 'md';
  glyph?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  track?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  size = 'md',
  glyph = true,
  href,
  type = 'button',
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;
const classes = ['button', `button--${size}`, className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a href={href} class:list={classes} data-track={track} {...externalAttrs} {...rest}>
    <slot />
    {glyph && <PixelIcon name="play" class="button__glyph" />}
  </a>
) : (
  <button type={type} class:list={classes} data-track={track} {...rest}>
    <slot />
    {glyph && <PixelIcon name="play" class="button__glyph" />}
  </button>
)}

<style>
  @layer components {
    .button {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-8);
      border-radius: var(--radius-md);
      background: var(--cta-bg);
      color: var(--cta-fg);
      font-family: var(--font-sans);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
      white-space: nowrap;
    }
    .button:hover {
      opacity: var(--hover-opacity);
    }

    .button--sm {
      padding: var(--space-10) var(--space-16);
    }
    /* Visual size stays compact; touch still gets a 44px hit area. */
    .button--sm::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      min-height: var(--tap-min);
      transform: translateY(-50%);
    }

    .button--md {
      min-height: var(--tap-min);
      padding: var(--space-14) var(--space-22);
    }
  }
</style>
