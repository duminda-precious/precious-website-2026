---
/**
 * Button: Label-style text (Funnel Sans 500, all caps), 4px corners (Claude Design).
 * Colours come from the theme (--cta-bg/--cta-fg): Deep Ink on light, inverse on dark.
 * Hover (mouse) / keyboard focus (M12, motion/buttonFx.ts + buttonGlitch.ts):
 *   - the soft wash blooms in as pixels from where the pointer entered, and a light
 *     noise radiates from the cursor while hovering; it dissolves back out on leave,
 *   - a small pixel butterfly lands beside the label, flaps, and lifts off on leave,
 *   - the label turns Deep Ink and glitches into pixels and back,
 *   - a small press on pointer down.
 * Without JS the wash simply shows on hover (CSS fallback below).
 * Renders <a> when href is set, otherwise <button>.
 * Props:
 *   size  'sm' (nav, section CTAs) | 'md' (44px tall)
 *   cta   section CTA: its label also glitches every few seconds while in view
 *   fly   show the landing butterfly (default true)
 *   href, type, track (→ data-track), external, class
 * Tokens: --cta-bg, --cta-fg, --cta-hover-bg, --cta-hover-fg, --radius-xs, --font-sans,
 *         --text-label, --tracking-label, --weight-label, --leading-none, --space-*, --tap-min.
 * Motion hooks: data-button, data-grad (bloom), data-grad-nofly, data-cta, data-pixel-label.
 */
interface Props {
  size?: 'sm' | 'md';
  cta?: boolean;
  fly?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  track?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  size = 'sm',
  cta = false,
  fly = true,
  href,
  type = 'button',
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
const attrs = {
  class: ['button', `button--${size}`, className].filter(Boolean).join(' '),
  'data-track': track,
  'data-button': '',
  'data-grad': '',
  'data-grad-nofly': fly ? undefined : '',
  'data-cta': cta ? '' : undefined,
  ...(href ? { href } : { type }),
  ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
  ...rest,
};
---

<Tag {...attrs}>
  <span class="button__label" data-pixel-label><slot /></span>
</Tag>

<style>
  @layer components {
    .button {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-xs);
      background: var(--cta-bg);
      color: var(--cta-fg);
      font-family: var(--font-sans);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
      white-space: nowrap;
    }
    .button:hover {
      opacity: 1;
    }
    .button__label {
      position: relative;
    }
    /* Hover and focus: the label turns Deep Ink over the wash. */
    .button:focus-visible {
      color: var(--cta-hover-fg);
    }
    @media (hover: hover) {
      .button:hover {
        color: var(--cta-hover-fg);
      }
    }
    /* No-JS fallback: the wash shows directly (buttonFx sets data-fx when it runs). */
    .button:not([data-fx]):focus-visible {
      background: var(--cta-hover-bg);
    }
    @media (hover: hover) {
      .button:not([data-fx]):hover {
        background: var(--cta-hover-bg);
      }
    }

    .button--sm {
      padding: var(--space-10) var(--space-16);
    }
    /* Visual size stays compact; touch still gets a 44px hit area. */
    .button--sm::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      min-height: var(--tap-min);
      transform: translateY(-50%);
    }
    .button--md {
      min-height: var(--tap-min);
      padding: var(--space-14) var(--space-22);
    }
  }
</style>
