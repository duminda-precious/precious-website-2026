---
/**
 * Button: Label-style text (Funnel Sans 500, all caps) and a pixel ▸ glyph, 12px corners.
 * One solid style site-wide; its colours come from the theme (--cta-bg/--cta-fg),
 * so it is Deep Ink on light sections and inverse on dark ones.
 * Hover / keyboard focus: the fill dissolves to the brand gradient in pixel steps
 * and the label turns Deep Ink (motion/pixelHover.ts). Without JS, or with reduced
 * motion, the gradient swaps in instantly (CSS below).
 * Renders <a> when href is set, otherwise <button>.
 * Props:
 *   size  'sm' (nav) | 'md'
 *   glyph show the ▸ (default true)
 *   href, type, track (→ data-track, e.g. "book-call"), external, class
 * Tokens: --cta-bg, --cta-fg, --cta-hover-bg, --cta-hover-fg, --radius-md, --font-sans,
 *         --text-label, --tracking-label, --weight-label, --space-*, --tap-min.
 * Motion hooks: data-pixel-fill (button), data-pixel-layer (cell container),
 *               data-pixel-lit (set while the gradient is mostly in; also steps the ▸ right).
 */
import PixelIcon from './PixelIcon.astro';
interface Props {
  size?: 'sm' | 'md';
  glyph?: boolean;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  track?: string;
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  size = 'md',
  glyph = true,
  href,
  type = 'button',
  track,
  external = false,
  class: className,
  ...rest
} = Astro.props;
const classes = ['button', `button--${size}`, className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href ? (
  <a
    href={href}
    class:list={classes}
    data-track={track}
    data-pixel-fill
    {...externalAttrs}
    {...rest}
  >
    <span class="button__pixels" aria-hidden="true" data-pixel-layer />
    <span class="button__label">
      <slot />
    </span>
    {glyph && <PixelIcon name="play" class="button__glyph" />}
  </a>
) : (
  <button type={type} class:list={classes} data-track={track} data-pixel-fill {...rest}>
    <span class="button__pixels" aria-hidden="true" data-pixel-layer />
    <span class="button__label">
      <slot />
    </span>
    {glyph && <PixelIcon name="play" class="button__glyph" />}
  </button>
)}

<style>
  @layer components {
    .button {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-8);
      border-radius: var(--radius-md);
      background: var(--cta-bg);
      color: var(--cta-fg);
      font-family: var(--font-sans);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
      white-space: nowrap;
    }
    /* No opacity fade (the global link hover): the pixel fill is the hover. */
    .button:hover {
      opacity: 1;
    }

    /* Cells are added by pixelHover.ts; the label and glyph paint above them. */
    .button__pixels {
      position: absolute;
      inset: 0;
      overflow: hidden;
      border-radius: inherit;
      pointer-events: none;
    }
    .button__label,
    .button > :global(.button__glyph) {
      position: relative;
    }
    .button[data-pixel-lit] {
      color: var(--cta-hover-fg);
    }
    /* Secondary motion: the ▸ steps one pixel unit right with the fill (no tween). */
    .button[data-pixel-lit] > :global(.button__glyph) {
      transform: translateX(var(--pixel-unit));
    }

    /* Fallback without the pixel module (no JS, reduced motion): instant swap. */
    :global(html:not([data-pixel-hover])) .button:is(:hover, :focus-visible) {
      background: var(--cta-hover-bg);
      color: var(--cta-hover-fg);
    }
    :global(html:not([data-pixel-hover]))
      .button:is(:hover, :focus-visible)
      > :global(.button__glyph) {
      transform: translateX(var(--pixel-unit));
    }

    .button--sm {
      padding: var(--space-10) var(--space-16);
    }
    /* Visual size stays compact; touch still gets a 44px hit area. */
    .button--sm::after {
      content: '';
      position: absolute;
      inset: 50% 0 auto;
      min-height: var(--tap-min);
      transform: translateY(-50%);
    }

    .button--md {
      min-height: var(--tap-min);
      padding: var(--space-14) var(--space-22);
    }
  }
</style>
