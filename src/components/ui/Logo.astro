---
/**
 * Logo: the Precious Studio logo (reference/brand/logo-white.svg), coloured with
 * currentColor so the theme decides: Deep Ink on light, white on dark.
 * The butterfly is drawn as one merged path on its 13 × 11 pixel grid, so no seams
 * show between pixels. motion/logoWings.ts animates it (Claude Design): the wings
 * flap at 8fps with an LCD ghost of the previous frame, and hovering the nearest
 * [data-logo-hover] ancestor sends a brand-colour ripple through the pixels.
 * Props:
 *   variant 'wordmark' (letters + butterfly) | 'mark' (butterfly only)
 *   label   accessible name; omit when the parent already has one (then aria-hidden)
 *   class
 * Size it from the parent: set a height (width follows) or a width (height follows).
 * Tokens: none (colour is inherited).
 * Motion hooks: data-logo, data-logo-mark.
 */
import { LOGO_LETTERS, LOGO_VIEWBOX, MARK_ORIGIN, MARK_UNIT } from './logo';
import { pixelPath, pixelSize } from './pixelIcons';

interface Props {
  variant?: 'wordmark' | 'mark';
  label?: string;
  class?: string;
}
const { variant = 'wordmark', label, class: className } = Astro.props;

const mark = pixelSize('butterfly');
const isMark = variant === 'mark';
const viewBox = isMark
  ? `0 0 ${mark.cols} ${mark.rows}`
  : `0 0 ${LOGO_VIEWBOX.width} ${LOGO_VIEWBOX.height}`;
const markTransform = isMark
  ? undefined
  : `translate(${MARK_ORIGIN.x} ${MARK_ORIGIN.y}) scale(${MARK_UNIT})`;
---

<svg
  class:list={['logo', `logo--${variant}`, className]}
  viewBox={viewBox}
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-logo={variant}
>
  {!isMark && LOGO_LETTERS.map((d) => <path d={d} fill="currentColor" />)}
  <g transform={markTransform} fill="currentColor" shape-rendering="crispEdges" data-logo-mark>
    <path d={pixelPath('butterfly')}></path>
  </g>
</svg>

<style>
  @layer components {
    .logo {
      display: block;
      overflow: visible;
    }
  }
</style>
