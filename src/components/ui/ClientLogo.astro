---
/**
 * ClientLogo: a client's logo at a fixed height, never cropped (object-fit: contain,
 * left-aligned). The parent sets --client-logo-height (and optionally -max-width). Accepts a hosted URL or an astro:assets import.
 * Props: src, alt, class.
 * Tokens: --client-logo-height, --client-logo-max-width (set by the parent).
 * Motion hooks: none.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: className } = Astro.props;
---

{typeof src === 'string' ? (
  <img
    class:list={['client-logo', className]}
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
) : (
  <Image class:list={['client-logo', className]} src={src} alt={alt} />
)}

<style>
  @layer components {
    .client-logo {
      display: block;
      width: auto;
      max-width: var(--client-logo-max-width, none);
      height: var(--client-logo-height);
      object-fit: contain;
      object-position: left center;
    }
  }
</style>
