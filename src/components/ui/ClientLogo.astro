---
/**
 * ClientLogo: a client's logo, scaled to the parent's height and never cropped
 * (object-fit: contain, left-aligned). Accepts a hosted URL or an astro:assets import.
 * Props: src, alt, class.
 * Tokens: none (size comes from the parent).
 * Motion hooks: none.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: className } = Astro.props;
---

{typeof src === 'string' ? (
  <img
    class:list={['client-logo', className]}
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
) : (
  <Image class:list={['client-logo', className]} src={src} alt={alt} />
)}

<style>
  @layer components {
    .client-logo {
      display: block;
      width: auto;
      max-width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: left center;
    }
  }
</style>
