---
/**
 * RevealCard: gate card (M5). Media on top, coloured panel below with the title;
 * the pain/result lines reveal on hover and keyboard focus (grid-template-rows
 * 0fr → 1fr). On touch (hover: none) the lines show expanded. The lines are
 * always in the DOM for screen readers.
 * Props: tone ('gate-1' | 'gate-2' | 'gate-3'), title, pain, result, mediaLabel, media, mediaAlt.
 * Tokens: --gate-N-bg/-fg/-pain/-media, --radius-lg, --space-*, --text-title, --tracking-title,
 *         --leading-heading, --text-body, --dur-reveal, --dur-base, --ease-out-soft, --focus-ring.
 * Motion hooks: CSS only.
 */
import MediaFrame from './MediaFrame.astro';
import PixelIcon from './PixelIcon.astro';

interface Props {
  tone: 'gate-1' | 'gate-2' | 'gate-3';
  title: string;
  pain: string;
  result: string;
  mediaLabel: string;
  media?: string;
  mediaAlt?: string;
}
const { tone, title, pain, result, mediaLabel, media, mediaAlt = '' } = Astro.props;
---

<article class:list={['reveal-card', `reveal-card--${tone}`]} tabindex="0" data-motion="rise-in">
  <MediaFrame
    aspect="fill"
    tone="gradient"
    label={mediaLabel}
    image={media}
    alt={mediaAlt}
    rounded={false}
  />
  <div class="reveal-card__panel">
    <h3 class="reveal-card__title">{title}</h3>
    <div class="reveal-card__reveal">
      <div class="reveal-card__inner">
        <p class="reveal-card__pain">{pain}</p>
        <p>
          <PixelIcon name="arrow-right" class="reveal-card__arrow" />
          {result}
        </p>
      </div>
    </div>
  </div>
</article>

<style>
  @layer components {
    .reveal-card {
      display: flex;
      flex-direction: column;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: var(--radius-lg);
      cursor: default;
    }
    .reveal-card:focus-visible {
      outline: 2px solid var(--focus-ring);
      outline-offset: var(--space-4);
    }
    .reveal-card--gate-1 {
      --mf-gradient: var(--gate-1-media);
      --card-bg: var(--gate-1-bg);
      --card-fg: var(--gate-1-fg);
      --card-pain: var(--gate-1-pain);
    }
    .reveal-card--gate-2 {
      --mf-gradient: var(--gate-2-media);
      --card-bg: var(--gate-2-bg);
      --card-fg: var(--gate-2-fg);
      --card-pain: var(--gate-2-pain);
    }
    .reveal-card--gate-3 {
      --mf-gradient: var(--gate-3-media);
      --card-bg: var(--gate-3-bg);
      --card-fg: var(--gate-3-fg);
      --card-pain: var(--gate-3-pain);
    }
    .reveal-card__panel {
      padding: var(--space-22);
      background: var(--card-bg);
      color: var(--card-fg);
    }
    .reveal-card__title {
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-title);
      letter-spacing: var(--tracking-title);
      line-height: var(--leading-heading);
    }
    .reveal-card__reveal {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows var(--dur-reveal) var(--ease-out-soft),
        opacity var(--dur-base) var(--ease-out-soft);
    }
    .reveal-card__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      min-height: 0;
      overflow: hidden;
      padding-top: var(--space-12);
      font-size: var(--text-body);
    }
    .reveal-card__inner :global(.reveal-card__arrow) {
      margin-right: var(--space-8);
    }
    .reveal-card__pain {
      color: var(--card-pain);
    }
    .reveal-card:hover .reveal-card__reveal,
    .reveal-card:focus-within .reveal-card__reveal {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    /* Touch: no hover, so show the lines by default. */
    @media (hover: none) {
      .reveal-card__reveal {
        grid-template-rows: 1fr;
        opacity: 1;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal-card__reveal {
        transition: none;
      }
    }
  }
</style>
