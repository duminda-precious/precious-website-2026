---
/**
 * Tag: small outlined label for metadata (case study situation: REDESIGN, …).
 * Mono uppercase per the brief's type roles. Content is written in normal case
 * in content files; CSS uppercases it.
 * Props: as, class.
 * Tokens: --tag-border, --radius-pill, --font-mono, --text-mono-sm, --tracking-mono, --space-*.
 * Motion hooks: none.
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'span', class: className, ...rest } = Astro.props;
---

<Tag class:list={['tag', className]} {...rest}>
  <slot />
</Tag>

<style>
  @layer components {
    .tag {
      display: inline-block;
      align-self: flex-start;
      padding: var(--space-6) var(--space-10);
      border: var(--border-width) solid var(--tag-border);
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: var(--text-mono-sm);
      letter-spacing: var(--tracking-mono);
      line-height: var(--leading-none);
      text-transform: uppercase;
    }
  }
</style>
