---
/**
 * MobileMenu: Menu button + full-screen overlay below md (plan §3.2).
 * Built on a modal <dialog>: the rest of the page is inert while open (focus
 * trap), Esc closes it, focus returns to the Menu button, and the page scroll is
 * locked. It opens and closes (Close button, Esc) through a pixel reveal (M16). Visual treatment is deliberately minimal (phase 2 styles it).
 * Props: services (dropdown items for the Services group; links from src/config/navigation.ts).
 * Services is a collapsible accordion (closed by default) with an inset, grey sub-list (brief M11).
 * Tokens: --surface-page, --text-primary, --text-secondary, --gutter, --space-*, --text-menu,
 *         --tracking-heading, --font-sans, --text-label, --tap-min, --radius-pill,
 *         --border-width, --nav-badge-*, --dur-base, --ease-standard.
 * Motion hooks: data-menu-root (init/cleanup is lifecycle-safe for View Transitions);
 *               pixel reveal via motion/pixelClip.ts (--pixel-cell-menu, --pixel-reveal-steps,
 *               --dur-pixel-reveal); off with reduced motion.
 */
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import { primaryNav, bookCall, isDropdown, type NavLink } from '../../config/navigation';
import { ui } from '../../config/ui';

interface Props {
  services: NavLink[];
}
const { services } = Astro.props;
---

<div class="menu-root" data-menu-root>
  <button
    class="menu-button"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-open
  >
    {ui.menu.open}
  </button>

  <dialog
    id="mobile-menu"
    class="menu"
    aria-label={ui.menu.label}
    data-menu-dialog
    data-lenis-prevent
  >
    <div class="menu__inner">
      <div class="menu__top">
        <a class="menu__brand" href="/" aria-label={ui.brandHomeLabel} data-menu-link>
          <Logo class="menu__logo" />
        </a>
        <button class="menu-button" type="button" data-menu-close>
          {ui.menu.close}
        </button>
      </div>

      <nav aria-label={ui.primaryNavLabel}>
        <ul class="menu__list">
          {primaryNav.map((item, i) =>
            isDropdown(item) ? (
              <li>
                <button
                  class="menu__group-label"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`menu-group-${i}`}
                  data-menu-accordion
                >
                  {item.label}
                  <span class="menu__caret" aria-hidden="true">
                    <PixelIcon name="caret-down" size="lg" />
                  </span>
                </button>
                <ul id={`menu-group-${i}`} class="menu__sublist" hidden>
                  {[item.overview, ...services].map((link) => (
                    <li>
                      <a class="menu__sublink" href={link.href} data-menu-link>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a class="menu__link" href={item.href} data-menu-link>
                  {item.label}
                  {item.badge && <span class="menu__badge">{item.badge}</span>}
                </a>
              </li>
            ),
          )}
        </ul>
      </nav>

      <div class="menu__cta">
        <Button href={bookCall.href} track={bookCall.track} data-menu-link>
          {bookCall.label}
        </Button>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { pixelClip } from '../../motion/pixelClip';
  import { prefersReducedMotion } from '../../motion/reducedMotion';

  const DESKTOP = '(min-width: 47.5rem)';

  function initMenus() {
    document
      .querySelectorAll<HTMLElement>('[data-menu-root]:not([data-menu-ready])')
      .forEach((root) => {
        root.dataset.menuReady = '';
        const openBtn = root.querySelector<HTMLButtonElement>('[data-menu-open]')!;
        const dialog = root.querySelector<HTMLDialogElement>('[data-menu-dialog]')!;
        const controller = new AbortController();
        const { signal } = controller;

        // M16: the menu reveals / hides through pixel cells (not with reduced motion).
        const clip = pixelClip(dialog, '--pixel-cell-menu');
        const animate = () => !prefersReducedMotion();

        const open = () => {
          if (animate()) dialog.style.clipPath = "path('M0 0z')";
          dialog.showModal();
          if (animate()) clip.to(true);
          openBtn.setAttribute('aria-expanded', 'true');
          document.documentElement.classList.add('is-scroll-locked');
          document.dispatchEvent(new Event('scroll:lock'));
        };
        /** Instant close (link clicks: the page transition takes over). */
        const close = () => {
          clip.reset();
          if (dialog.open) dialog.close();
        };
        /** Close button and Esc: pixel out, then close. */
        const closeAnimated = () => {
          if (!dialog.open) return;
          if (!animate()) return close();
          clip.to(false).then(close);
        };

        openBtn.addEventListener('click', open, { signal });
        root
          .querySelector('[data-menu-close]')!
          .addEventListener('click', closeAnimated, { signal });
        dialog.addEventListener(
          'cancel',
          (e) => {
            e.preventDefault();
            closeAnimated();
          },
          { signal },
        );
        // Esc fires "cancel" then "close"; every close path ends here.
        dialog.addEventListener(
          'close',
          () => {
            openBtn.setAttribute('aria-expanded', 'false');
            document.documentElement.classList.remove('is-scroll-locked');
            document.dispatchEvent(new Event('scroll:unlock'));
            openBtn.focus({ preventScroll: true });
          },
          { signal },
        );
        // Services is an accordion, closed by default.
        root.querySelectorAll<HTMLButtonElement>('[data-menu-accordion]').forEach((btn) => {
          const panel = document.getElementById(btn.getAttribute('aria-controls')!)!;
          btn.addEventListener(
            'click',
            () => {
              const expand = btn.getAttribute('aria-expanded') !== 'true';
              btn.setAttribute('aria-expanded', String(expand));
              panel.hidden = !expand;
            },
            { signal },
          );
        });
        // Following a link closes the menu; the navigation itself proceeds.
        root
          .querySelectorAll('[data-menu-link]')
          .forEach((link) => link.addEventListener('click', close, { signal }));
        // Growing past the breakpoint while open leaves no visible way to close it, so close.
        matchMedia(DESKTOP).addEventListener('change', (e) => e.matches && close(), { signal });

        // Tear down before a View Transitions swap (plan §2 lifecycle rule).
        document.addEventListener(
          'astro:before-swap',
          () => {
            close();
            controller.abort();
          },
          { once: true },
        );
      });
  }

  initMenus();
  document.addEventListener('astro:page-load', initMenus);
</script>

<style>
  @layer components {
    .menu-root {
      display: contents;
    }
    .menu-button {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-min);
      padding: 0 var(--space-16);
      border: var(--border-width) solid currentColor;
      border-radius: var(--radius-pill);
      font-family: var(--font-sans);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
    }
    .menu-button:hover {
      opacity: var(--hover-opacity);
    }

    @media (min-width: 47.5rem) {
      .menu-root > .menu-button {
        display: none;
      }
    }

    .menu {
      width: 100%;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: var(--surface-page);
      color: var(--text-primary);
    }
    .menu::backdrop {
      background: transparent;
    }

    .menu__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-40);
      min-height: 100%;
      padding: var(--space-16) var(--gutter) var(--space-40);
    }
    .menu__top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-16);
    }
    .menu__brand {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-min);
    }
    .menu__brand :global(.menu__logo) {
      height: var(--logo-height-nav);
      width: auto;
    }
    .menu__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      list-style: none;
    }
    .menu__link,
    .menu__group-label {
      display: flex;
      align-items: center;
      gap: var(--space-12);
      padding-block: var(--space-4);
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-menu);
      letter-spacing: var(--tracking-heading);
      line-height: var(--leading-heading);
    }
    .menu__group-label {
      width: 100%;
      text-align: left;
    }
    .menu__caret {
      display: inline-flex;
      transition: transform var(--dur-fast) var(--ease-standard);
    }
    .menu__group-label[aria-expanded='true'] .menu__caret {
      transform: rotate(180deg);
    }
    .menu__sublist[hidden] {
      display: none;
    }
    .menu__sublist {
      display: flex;
      flex-direction: column;
      padding-left: var(--space-24);
      list-style: none;
    }
    .menu__sublink {
      display: flex;
      align-items: center;
      min-height: var(--tap-min);
      font-size: var(--text-large);
      letter-spacing: var(--tracking-title);
      color: var(--text-secondary);
    }
    .menu__badge {
      padding: var(--space-4) var(--space-6);
      border-radius: var(--radius-pill);
      background: var(--nav-badge-bg);
      color: var(--nav-badge-fg);
      font-family: var(--font-sans);
      font-weight: var(--weight-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
      font-size: var(--text-eyebrow);
      line-height: var(--leading-none);
    }
    .menu__cta {
      margin-top: auto;
    }

    @media (prefers-reduced-motion: reduce) {
      .menu__caret {
        transition: none;
      }
    }
  }
</style>
