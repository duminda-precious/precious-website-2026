---
/**
 * StubLayout: placeholder for inner pages being rebuilt (plan §3.1).
 * H1, one line, a link home, full nav and footer, real SEO. noindex by default.
 * Placed on the full-width grid (cols 1–9, capped by measure).
 * Props: seo (title, description, noindex), heading, message (defaults to ui.stub.message),
 *        showBookCall (adds the Book a call button, used by 404).
 * Slot: default (extra content under the message, e.g. contact details).
 * Tokens: --text-statement, --tracking-heading, --leading-heading, --text-medium,
 *         --leading-medium, --text-secondary, --space-*.
 */
import SiteShell from './SiteShell.astro';
import Section from '../primitives/Section.astro';
import Grid12 from '../primitives/Grid12.astro';
import GridItem from '../primitives/GridItem.astro';
import Stack from '../primitives/Stack.astro';
import Cluster from '../primitives/Cluster.astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import type { SeoProps } from './Seo.astro';
import { bookCall } from '../../config/navigation';
import { ui } from '../../config/ui';

interface Props {
  seo: Pick<SeoProps, 'title' | 'description' | 'noindex'>;
  heading: string;
  message?: string;
  showBookCall?: boolean;
}
const { seo, heading, message = ui.stub.message, showBookCall = false } = Astro.props;
---

<SiteShell {...seo} noindex={seo.noindex ?? true}>
  <Section labelledby="page-title">
    <Grid12 class="stub">
      <GridItem span={9} measure="statement">
        <Stack gap="24">
          <h1 id="page-title" class="stub__title">
            {heading}
          </h1>
          <p class="stub__message">{message}</p>
          <slot />
          <Cluster gap="24">
            {showBookCall && (
              <Button href={bookCall.href} track={bookCall.track}>
                {bookCall.label}
              </Button>
            )}
            <TextLink href="/" arrow={false}>
              {ui.stub.backHome}
            </TextLink>
          </Cluster>
        </Stack>
      </GridItem>
    </Grid12>
  </Section>
</SiteShell>

<style>
  @layer components {
    .stub {
      min-height: 50svh;
      align-content: center;
    }
    .stub__title {
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-statement);
      letter-spacing: var(--tracking-heading);
      line-height: var(--leading-heading);
    }
    .stub__message {
      font-size: var(--text-medium);
      line-height: var(--leading-medium);
      color: var(--text-secondary);
    }
  }
</style>
