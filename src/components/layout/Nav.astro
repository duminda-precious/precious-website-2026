---
/**
 * Nav: sticky header (brief §3 item 1, M7; decisions 2026-09-29).
 * Logo alone at the left. On the right, a cluster of page links (mono uppercase),
 * the Services dropdown (hover on mouse devices, click/keyboard everywhere), and the
 * Book a call button. At the top of the page the
 * cluster floats with no background; once scrolled, a rounded backdrop fades in
 * behind it. The logo never gets a backdrop. No hide-on-scroll.
 * Below md (760px) the links and button move into MobileMenu.
 * Props: none (links from src/config/navigation.ts, dropdown items from the services collection).
 * Tokens: --nav-fg, --nav-cluster-bg (+ -dark), --nav-dropdown-*, --nav-badge-*, --nav-height,
 *         --gutter, --space-*, --font-sans, --text-label, --tracking-label, --radius-pill,
 *         --radius-md, --z-nav, --z-dropdown, --dur-fast, --dur-theme, --ease-css, --ease-standard.
 * Motion hooks: data-nav (theme switch sets data-nav-theme="dark", M2); data-scrolled (M7;
 *               also collapses the logo to the butterfly, M15).
 */
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import MobileMenu from './MobileMenu.astro';
import { primaryNav, bookCall, isDropdown } from '../../config/navigation';
import { ui } from '../../config/ui';
import { getServices } from '../../lib/content';

const services = await getServices();
const dropdownItems = (overview: { label: string; href: string }) => [
  overview,
  ...services.map((s) => ({ label: s.data.title, href: `/services/${s.id}` })),
];
---

<header class="nav" data-nav transition:name="site-nav" transition:animate="none">
  <a class="nav__brand" href="/" aria-label={ui.brandHomeLabel}>
    <Logo class="nav__logo" />
  </a>

  <div class="nav__cluster">
    <nav class="nav__links" aria-label={ui.primaryNavLabel}>
      <ul class="nav__list">
        {primaryNav.map((item, i) =>
          isDropdown(item) ? (
            <li class="nav__dropdown" data-dropdown>
              <button
                class="nav__link nav__trigger"
                type="button"
                aria-expanded="false"
                aria-controls={`nav-dropdown-${i}`}
                data-dropdown-trigger
              >
                {item.label}
                <span class="nav__caret" aria-hidden="true">
                  <PixelIcon name="caret-down" />
                </span>
              </button>
              <ul id={`nav-dropdown-${i}`} class="nav__panel" data-dropdown-panel hidden>
                {dropdownItems(item.overview).map((link) => (
                  <li>
                    <a class="nav__panel-link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
                {item.badge && <span class="nav__badge">{item.badge}</span>}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <Button size="sm" href={bookCall.href} track={bookCall.track} class="nav__cta">
      {bookCall.label}
    </Button>

    <MobileMenu
      services={services.map((s) => ({ label: s.data.title, href: `/services/${s.id}` }))}
    />
  </div>
</header>

<script>
  function initNav() {
    document.querySelectorAll<HTMLElement>('[data-nav]:not([data-nav-ready])').forEach((nav) => {
      nav.dataset.navReady = '';
      const controller = new AbortController();
      const { signal } = controller;

      // M7: backdrop behind the link cluster once the page has scrolled.
      let ticking = false;
      const updateScrolled = () => {
        ticking = false;
        nav.toggleAttribute('data-scrolled', window.scrollY > 0);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(updateScrolled);
          }
        },
        { passive: true, signal },
      );
      updateScrolled();

      // Dropdowns: the label only opens the panel (it is not a link). On mouse
      // devices it also opens on hover. Esc, outside click, pointer leaving and
      // focus leaving the dropdown close it.
      nav.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
        const trigger = dropdown.querySelector<HTMLButtonElement>('[data-dropdown-trigger]')!;
        const panel = dropdown.querySelector<HTMLElement>('[data-dropdown-panel]')!;
        const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
        const setOpen = (open: boolean) => {
          trigger.setAttribute('aria-expanded', String(open));
          panel.hidden = !open;
        };
        const canHover = matchMedia('(hover: hover) and (pointer: fine)');
        // A click right after a hover-open keeps the panel open instead of toggling it shut.
        let openedByHover = false;
        trigger.addEventListener(
          'click',
          () => {
            if (openedByHover) {
              openedByHover = false;
              return;
            }
            setOpen(!isOpen());
          },
          { signal },
        );
        dropdown.addEventListener(
          'pointerenter',
          (e) => {
            if (e.pointerType === 'mouse' && canHover.matches && !isOpen()) {
              openedByHover = true;
              setOpen(true);
            }
          },
          { signal },
        );
        dropdown.addEventListener(
          'pointerleave',
          (e) => {
            if (e.pointerType === 'mouse' && canHover.matches) {
              openedByHover = false;
              setOpen(false);
            }
          },
          { signal },
        );
        dropdown.addEventListener(
          'keydown',
          (e) => {
            if (e.key === 'Escape' && isOpen()) {
              setOpen(false);
              trigger.focus();
            }
          },
          { signal },
        );
        dropdown.addEventListener(
          'focusout',
          (e) => {
            if (!dropdown.contains(e.relatedTarget as Node | null)) setOpen(false);
          },
          { signal },
        );
        document.addEventListener(
          'click',
          (e) => {
            if (!dropdown.contains(e.target as Node)) setOpen(false);
          },
          { signal },
        );
      });

      // Tear down before a View Transitions swap (plan §2 lifecycle rule).
      document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    });
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  @layer components {
    .nav {
      position: sticky;
      top: 0;
      z-index: var(--z-nav);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-16);
      min-height: var(--nav-height);
      padding: var(--space-8) var(--gutter);
      color: var(--nav-fg);
      transition: color var(--dur-theme) var(--ease-css);
    }
    .nav[data-nav-theme='dark'] {
      --nav-fg: var(--nav-fg-dark);
      --nav-cluster-bg: var(--nav-cluster-bg-dark);
    }

    .nav__brand {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-min);
    }
    .nav__brand :global(.nav__logo) {
      height: var(--logo-height-nav);
      width: auto;
      transform-origin: var(--logo-mark-start) 50%;
      transition:
        clip-path var(--dur-logo-collapse) var(--ease-out-expo),
        transform var(--dur-logo-collapse) var(--ease-out-expo);
    }
    /* M15: once scrolled, the wordmark clips down to the pixel butterfly, which
       slides to the left edge and grows a little. Back at the top it expands. */
    .nav[data-scrolled] .nav__brand :global(.nav__logo) {
      clip-path: inset(-30% var(--logo-mark-end-inset) -30% var(--logo-mark-start));
      transform: translateX(calc(var(--logo-mark-start) * -1)) scale(var(--logo-mark-scale));
    }

    .nav__cluster {
      display: flex;
      align-items: center;
      gap: var(--space-24);
      padding: var(--space-4);
      border-radius: var(--radius-pill);
      background-color: transparent;
      transition: background-color var(--dur-fast) var(--ease-standard);
    }
    .nav[data-scrolled] .nav__cluster {
      background-color: var(--nav-cluster-bg);
    }

    .nav__links,
    .nav__cluster > :global(.nav__cta) {
      display: none;
    }
    .nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-24);
      list-style: none;
    }
    .nav__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-8);
      min-height: var(--tap-min);
      font-family: var(--font-sans);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
      white-space: nowrap;
    }
    .nav__trigger:hover {
      opacity: var(--hover-opacity);
    }
    .nav__caret {
      display: inline-flex;
    }
    .nav__badge {
      padding: var(--space-4) var(--space-6);
      border-radius: var(--radius-pill);
      background: var(--nav-badge-bg);
      color: var(--nav-badge-fg);
      font-weight: var(--weight-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
      font-size: var(--text-eyebrow);
      text-transform: none; /* eyebrow: title case, not the link caps */
    }

    .nav__dropdown {
      position: relative;
    }
    .nav__panel {
      position: absolute;
      top: 100%;
      left: calc(var(--space-16) * -1);
      z-index: var(--z-dropdown);
      display: flex;
      flex-direction: column;
      min-width: 16rem;
      padding: var(--space-8);
      list-style: none;
      background: var(--nav-dropdown-bg);
      color: var(--nav-dropdown-fg);
      border: var(--border-width) solid var(--nav-dropdown-border);
      border-radius: var(--radius-md);
      box-shadow: var(--nav-dropdown-shadow);
    }
    .nav__panel[hidden] {
      display: none;
    }
    .nav__panel-link {
      display: flex;
      align-items: center;
      min-height: var(--tap-min);
      padding: 0 var(--space-8);
      font-family: var(--font-sans);
      font-weight: var(--weight-label);
      letter-spacing: var(--tracking-label);
      font-size: var(--text-label);
      text-transform: uppercase;
      line-height: var(--leading-none);
    }

    @media (min-width: 47.5rem) {
      .nav__links {
        display: block;
        padding-left: var(--space-16);
      }
      .nav__cluster > :global(.nav__cta) {
        display: inline-flex;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .nav,
      .nav__cluster,
      .nav__brand :global(.nav__logo) {
        transition: none;
      }
    }
  }
</style>
