---
/**
 * Nav (Claude Design): sticky header with two states.
 *   Rest  (top of the page, ≥1100px): the full wordmark; page links, the Services
 *         trigger (opens the mega menu), AI Design Agent + New, About; Book a call.
 *   Mini  (scrolled, or always below 1100px): the wordmark clips down to the
 *         butterfly; the links and Book a call slide right and fade into the 4-dot
 *         menu button, which opens the full-page menu (FullMenu).
 * Text and buttons follow the page theme, so the nav turns light over Work.
 * The mega menu opens on hover (mouse) or click, closes on pointer leave (after
 * --dur-hover-intent), Escape, or when the nav goes mini.
 * Props: none (links from src/config/navigation.ts).
 * Tokens: --nav-height, --gutter, --logo-height-nav(-sm), --logo-height-mark-sm, --logo-mark-*, --nav-dropdown-*,
 *         --nav-badge-*, --surface-hover, --grid-*, --radius-*, --text-*, --space-*,
 *         --dur-collapse, --dur-nav-fade, --dur-logo-collapse, --dur-theme, --dur-link,
 *         --dur-chevron, --ease-out-expo, --ease-standard, --ease-snappy, --z-nav.
 * Motion hooks: data-nav, data-mini, data-scrolled (motion/nav.ts), data-mega*,
 *               data-menu-open (motion/fullMenu.ts), data-logo-hover (logoWings.ts).
 */
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';
import Logo from '../ui/Logo.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import FullMenu from './FullMenu.astro';
import { primaryNav, bookCall, isDropdown, megaMenu } from '../../config/navigation';
import { ui } from '../../config/ui';
---

<header class="nav" data-nav transition:name="site-nav" transition:animate="none">
  <a class="nav__brand" href="/" aria-label={ui.brandHomeLabel} data-logo-hover>
    <Logo class="nav__logo" />
  </a>

  <div class="nav__cluster">
    <nav class="nav__links" aria-label={ui.primaryNavLabel}>
      <ul class="nav__list">
        {primaryNav.map((item) =>
          isDropdown(item) ? (
            <li data-mega-host>
              <button
                class="nav__link type-label"
                type="button"
                aria-expanded="false"
                aria-controls="nav-mega"
                data-mega-trigger
                data-no-glitch
              >
                {item.label}
                <span class="nav__chevron" aria-hidden="true">
                  <PixelIcon name="caret-down" />
                </span>
              </button>
            </li>
          ) : (
            <li>
              <a class="nav__link type-label" href={item.href}>
                {item.label}
                {item.badge && <span class="nav__badge">{item.badge}</span>}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <IconButton
      icon="dots"
      label={ui.menu.open}
      class="nav__menu"
      aria-haspopup="dialog"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-open
    />
    <Button href={bookCall.href} track={bookCall.track} class="nav__cta">
      {bookCall.label}
    </Button>
  </div>

  <div id="nav-mega" class="mega" data-theme="light" role="region" aria-label={ui.megaLabel} data-mega>
    <div class="mega__grid">
      {megaMenu.columns.map((col) => (
        <div class:list={['mega__col', `mega__col--${col.kind}`]} data-mega-col>
          <p class="mega__heading type-overline">{col.heading}</p>
          <ul class="mega__list">
            {col.items.map((it) => (
              <li data-mega-item>
                <a class="mega__link" href={it.href}>
                  <span class="mega__label">{it.label}</span>
                  {it.description && <span class="mega__desc">{it.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mega__note" data-mega-note>
      <p class="mega__note-text">{megaMenu.note}</p>
      <Button href={megaMenu.all.href} class="mega__note-cta" cta>{megaMenu.all.label}</Button>
    </div>
  </div>
</header>

<FullMenu />

<style>
  @layer components {
    .nav {
      position: sticky;
      top: 0;
      z-index: var(--z-nav);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-16);
      min-height: var(--nav-height);
      padding: var(--space-8) var(--gutter);
      color: var(--text-primary);
      transition: color var(--dur-theme) var(--ease-standard);
    }

    /* Logo: fills the bar; collapses to the butterfly once scrolled (M15). */
    .nav__brand {
      display: inline-flex;
      align-items: center;
      height: var(--logo-height-nav);
      min-width: 0;
      flex: 0 1 auto;
    }
    .nav__brand:hover {
      opacity: 1;
    }
    .nav :global(.nav__logo) {
      height: 100%;
      width: auto;
      transform-origin: var(--logo-mark-start) 50%;
      transition:
        clip-path var(--dur-logo-collapse) var(--ease-out-expo),
        transform var(--dur-logo-collapse) var(--ease-out-expo);
    }
    .nav[data-scrolled] :global(.nav__logo) {
      clip-path: inset(-30% var(--logo-mark-end-inset) -30% var(--logo-mark-start));
      transform: translateX(calc(var(--logo-mark-start) * -1)) scale(var(--logo-mark-scale));
    }
    /* Phones: the wordmark fills the space beside the menu button; once scrolled the
       butterfly is as tall as the buttons (the brand box grows instead of scaling). */
    @media (max-width: 47.49rem) {
      .nav__brand {
        height: var(--logo-height-nav-sm);
        transition: height var(--dur-logo-collapse) var(--ease-out-expo);
      }
      .nav[data-scrolled] .nav__brand {
        height: var(--logo-height-mark-sm);
      }
      .nav[data-scrolled] :global(.nav__logo) {
        transform: translateX(calc(var(--logo-mark-start) * -1));
      }
    }

    .nav__cluster {
      flex: none;
      display: flex;
      align-items: center;
      gap: var(--space-24);
    }
    .nav__links {
      padding-left: var(--space-16);
      overflow: hidden;
      max-width: var(--nav-links-max);
      transition:
        max-width var(--dur-collapse) var(--ease-out-expo),
        opacity var(--dur-nav-fade) var(--ease-standard),
        transform var(--dur-collapse) var(--ease-out-expo),
        padding var(--dur-collapse) var(--ease-out-expo);
    }
    .nav__list {
      display: flex;
      align-items: center;
      gap: var(--space-24);
    }
    .nav__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-8);
      min-height: var(--tap-min);
    }
    button.nav__link:hover {
      opacity: var(--hover-opacity);
    }
    .nav__chevron {
      display: inline-flex;
      transition: transform var(--dur-chevron) var(--ease-snappy);
    }
    [aria-expanded='true'] > .nav__chevron {
      transform: rotate(180deg);
    }
    .nav__badge {
      padding: var(--space-4) var(--space-6);
      border-radius: var(--radius-pill);
      background: var(--nav-badge-bg);
      color: var(--nav-badge-fg);
      font-weight: var(--weight-body);
      font-size: var(--text-eyebrow);
      text-transform: none;
      letter-spacing: 0;
    }
    .nav :global(.nav__menu) {
      width: 0;
      opacity: 0;
      transform: scale(0.6);
      pointer-events: none;
      transition:
        width var(--dur-collapse) var(--ease-out-expo),
        opacity var(--dur-nav-fade) var(--ease-standard),
        transform var(--dur-collapse) var(--ease-out-expo);
    }
    .nav :global(.nav__cta) {
      max-width: var(--nav-cta-max);
      transition:
        max-width var(--dur-collapse) var(--ease-out-expo),
        opacity var(--dur-nav-fade) var(--ease-standard),
        padding var(--dur-collapse) var(--ease-out-expo);
    }

    /* Mini: links and Book a call tuck into the menu button. */
    .nav[data-mini] .nav__cluster {
      gap: var(--space-4);
    }
    .nav[data-mini] .nav__links {
      max-width: 0;
      opacity: 0;
      transform: translateX(40%);
      padding-left: 0;
      pointer-events: none;
    }
    .nav[data-mini] :global(.nav__menu) {
      width: var(--icon-button);
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .nav[data-mini] :global(.nav__cta) {
      max-width: 0;
      opacity: 0;
      padding-inline: 0;
      pointer-events: none;
    }
    /* Without JS, narrow screens still get the mini layout. */
    @media (max-width: 68.74rem) {
      .nav:not([data-nav-ready]) .nav__links,
      .nav:not([data-nav-ready]) :global(.nav__cta) {
        display: none;
      }
    }

    /* Services mega menu: a panel of --mega-width on the right gutter, with its
       own 12-column grid (Services 6 · Approach 3 · Industries 3). It only shows
       at ≥1100px (below that the nav is always mini), so there is no stacked layout. */
    .mega {
      --mega-pad: var(--inset-card);
      position: absolute;
      top: calc(100% + var(--space-8));
      right: var(--gutter);
      width: min(var(--mega-width), 100% - var(--gutter) * 2);
      max-height: calc(100vh - var(--nav-height) - var(--space-16));
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      opacity: 0;
      padding: var(--mega-pad) var(--mega-pad) 0;
      background: var(--nav-dropdown-bg);
      color: var(--nav-dropdown-fg);
      border-radius: var(--radius-md);
      box-shadow: var(--nav-dropdown-shadow);
    }
    .mega[data-open] {
      visibility: visible;
      opacity: 1;
    }
    .mega__grid,
    .mega__note {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gap-col);
    }
    .mega__col {
      display: flex;
      flex-direction: column;
      gap: var(--space-14);
    }
    .mega__col--rich {
      grid-column: 1 / span 6;
    }
    .mega__col--plain {
      grid-column: span 3;
    }
    .mega__heading {
      color: var(--text-secondary);
    }
    .mega__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .mega__col--rich .mega__list {
      gap: var(--space-4);
    }
    .mega__link {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      margin: 0 calc(var(--space-12) * -1);
      padding: var(--space-8) var(--space-12);
      border-radius: var(--radius-sm);
      font-size: var(--text-body);
      line-height: var(--leading-snug);
      transition: background-color var(--dur-link) var(--ease-snappy);
    }
    .mega__col--rich .mega__link {
      padding-block: var(--space-10);
    }
    .mega__link:hover,
    .mega__link:focus-visible {
      opacity: 1;
      background: var(--surface-hover);
    }
    .mega__desc {
      max-width: var(--measure-card);
      font-size: var(--text-small);
      line-height: var(--leading-compact);
      color: var(--text-secondary);
    }
    /* The note is a band across the panel's foot. It bleeds to the panel edges and
       pads back by the same amount, so its columns match the grid above: the text
       sits in the Services columns and the button ends on column 12. */
    .mega__note {
      align-items: center;
      margin: var(--mega-pad) calc(var(--mega-pad) * -1) 0;
      padding: var(--space-20) var(--mega-pad);
      background: var(--nav-dropdown-note-bg);
      font-size: var(--text-small);
      line-height: var(--leading-compact);
      color: var(--text-secondary);
    }
    .mega__note-text {
      grid-column: 1 / span 6;
      max-width: var(--measure-card);
    }
    .mega__note :global(.mega__note-cta) {
      grid-column: 7 / -1;
      justify-self: end;
    }

    @media (prefers-reduced-motion: reduce) {
      .nav,
      .nav__brand,
      .nav :global(.nav__logo),
      .nav__links,
      .nav :global(.nav__menu),
      .nav :global(.nav__cta),
      .nav__chevron {
        transition: none;
      }
    }
  }
</style>
