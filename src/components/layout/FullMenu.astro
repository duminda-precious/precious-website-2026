---
/**
 * FullMenu (Claude Design): the full-page menu opened by the nav's 4-dot button.
 * White overlay on the site grid:
 *   top row      the animated logo (flaps, colour ripple on hover) · close button
 *   left  1–6    two journal cards (ContentCard), bottom-aligned
 *   right 8–12   large links; Services is an accordion listing the services;
 *                then Book a call (left) and LinkedIn (right) on one row
 * Below lg the links come first and the cards sit underneath.
 * Open: white pixels wipe out from the menu button (butterfly wing transition), then
 * the links and cards rise in. Close: the menu dissolves back into pixels that
 * clear toward the button. Focus trap, Esc, scroll lock, focus return (fullMenu.ts).
 * Props: none (links from src/config/navigation.ts, cards from home.journal).
 * Tokens: --surface-overlay, --text-menu, --leading-menu, --tracking-heading,
 *         --text-medium, --text-secondary, --grid-*, --gutter, --nav-height, --z-menu,
 *         --dur-expand, --dur-accordion-fade, --dur-chevron, --ease-snappy, --ease-standard,
 *         --space-*.
 * Motion hooks: data-menu, data-menu-close, data-menu-item, data-menu-card,
 *               data-menu-accordion (motion/fullMenu.ts).
 */
import Button from '../ui/Button.astro';
import IconButton from '../ui/IconButton.astro';
import Logo from '../ui/Logo.astro';
import PixelIcon from '../ui/PixelIcon.astro';
import ContentCard from '../ui/ContentCard.astro';
import { fullMenu, megaMenu, bookCall } from '../../config/navigation';
import { site } from '../../config/site';
import { ui } from '../../config/ui';
import { getHome } from '../../lib/content';

const home = await getHome();
const cards = home.journal.items.slice(0, 2);
const aspects = ['1 / 1', '5 / 6'];
const services = megaMenu.columns[0]!.items;
---

<div
  id="site-menu"
  class="menu"
  role="dialog"
  aria-modal="true"
  aria-label={ui.menu.label}
  data-theme="light"
  data-menu
  data-lenis-prevent
  hidden
>
  <div class="menu__top">
    <a class="menu__brand" href="/" aria-label={ui.brandHomeLabel} data-logo-hover data-menu-link>
      <Logo class="menu__logo" />
    </a>
    <IconButton icon="close" label={ui.menu.close} data-menu-close />
  </div>

  <div class="menu__main">
    <nav aria-label={ui.primaryNavLabel}>
      <ul class="menu__list">
        {fullMenu.map((link) =>
          link.label === 'Services' ? (
            <li data-menu-item>
              <button
                class="menu__link"
                type="button"
                aria-expanded="false"
                aria-controls="menu-services"
                data-menu-accordion
                data-no-glitch
              >
                {link.label}
                <span class="menu__chevron" aria-hidden="true">
                  <PixelIcon name="caret-down" size="lg" />
                </span>
              </button>
              <div id="menu-services" class="menu__sub">
                <div class="menu__sub-inner">
                  <ul class="menu__sub-list">
                    {[...services, megaMenu.all].map((s) => (
                      <li>
                        <a class="menu__sub-link" href={s.href} data-menu-link>
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ) : (
            <li data-menu-item>
              <a class="menu__link" href={link.href} data-menu-link>
                {link.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>
    <div class="menu__actions" data-menu-item>
      <Button href={bookCall.href} track={bookCall.track} cta data-menu-link>
        {bookCall.label}
      </Button>
      <a class="menu__social" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
        {ui.menu.linkedin}
      </a>
    </div>
  </div>

  <div class="menu__cards">
    {cards.map((c, i) => (
      <div data-menu-card>
        <ContentCard
          href={c.href}
          tag={c.tag}
          title={c.title}
          cta={home.journal.cardCta}
          image={c.image}
          aspect={aspects[i]}
          seed={i + 10}
        />
      </div>
    ))}
  </div>
</div>

<style>
  @layer components {
    .menu {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu);
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      grid-template-rows: auto auto 1fr;
      column-gap: var(--grid-gap-col);
      row-gap: var(--space-48);
      padding: var(--space-8) var(--gutter) var(--gutter);
      overflow: auto;
      overscroll-behavior: contain;
      background: var(--surface-overlay);
      color: var(--text-primary);
    }
    .menu[hidden] {
      display: none;
    }
    .menu__top {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: var(--nav-height);
    }
    .menu__brand {
      display: inline-flex;
      height: var(--logo-height-nav);
    }
    .menu__brand:hover {
      opacity: 1;
    }
    .menu__brand :global(.menu__logo) {
      height: 100%;
      width: auto;
    }
    .menu__main {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-48);
    }
    .menu__cards {
      grid-column: 1 / -1;
      align-self: end;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
      gap: var(--grid-gap-col);
    }
    /* Phones: no cards; the links fill the height. */
    @media (max-width: 47.49rem) {
      .menu {
        grid-template-rows: auto 1fr;
      }
      .menu__cards {
        display: none;
      }
    }
    @media (min-width: 62rem) {
      .menu {
        grid-template-rows: auto 1fr;
      }
      .menu__cards {
        grid-column: 1 / span 6;
        grid-row: 2;
      }
      .menu__main {
        grid-column: 8 / span 5;
        grid-row: 2;
        padding-top: var(--space-24);
      }
    }
    .menu__list {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .menu__link {
      display: inline-flex;
      align-items: center;
      gap: var(--space-16);
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-menu);
      line-height: var(--leading-menu);
      letter-spacing: var(--tracking-heading);
      text-align: left;
      transition: color var(--dur-link) var(--ease-snappy);
    }
    .menu__link:hover {
      opacity: 1;
      color: var(--text-secondary);
    }
    .menu__chevron {
      display: inline-flex;
      transition: transform var(--dur-chevron) var(--ease-snappy);
    }
    [aria-expanded='true'] > .menu__chevron {
      transform: rotate(180deg);
    }
    .menu__sub {
      display: grid;
      grid-template-rows: 0fr;
      transition:
        grid-template-rows var(--dur-expand) var(--ease-snappy),
        visibility 0s linear var(--dur-expand);
    }
    .menu__sub-inner {
      min-height: 0;
      overflow: hidden;
    }
    .menu__sub-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-10);
      padding: var(--space-16) 0 var(--space-20);
      opacity: 0;
      transition: opacity var(--dur-accordion-fade) var(--ease-standard);
    }
    [aria-expanded='true'] + .menu__sub {
      grid-template-rows: 1fr;
      transition-delay: 0s;
    }
    [aria-expanded='true'] + .menu__sub .menu__sub-list {
      opacity: 1;
    }
    /* Collapsed accordion content is out of the tab order. */
    [aria-expanded='false'] + .menu__sub {
      visibility: hidden;
    }
    .menu__sub-link {
      display: block;
      font-size: var(--text-medium);
      line-height: var(--leading-snug);
      color: var(--text-secondary);
      transition: color var(--dur-link) var(--ease-snappy);
    }
    .menu__sub-link:hover {
      opacity: 1;
      color: var(--text-primary);
    }
    .menu__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-16);
    }
    .menu__social {
      color: var(--text-secondary);
      transition: color var(--dur-link) var(--ease-snappy);
    }
    .menu__social:hover {
      opacity: 1;
      color: var(--text-primary);
    }
    @media (prefers-reduced-motion: reduce) {
      .menu__sub,
      .menu__sub-list,
      .menu__chevron {
        transition: none;
      }
    }
  }
</style>
