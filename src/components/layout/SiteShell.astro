---
/**
 * SiteShell: the document for every public page.
 *   <head> (layer order, SEO) → skip link → page wrapper (nav + main) → footer.
 * The page wrapper sits above the footer (z-index) with an opaque background,
 * and rounded bottom corners from lg, so it lifts off the sticky footer (brief M6).
 *
 * Props: SEO props (title, description, noindex, type, image, canonical).
 * Slots: default (main content), "head" (extra head tags), "jsonld".
 * Tokens: --page-bg, --z-page, --z-skip, --dur-page, --ease-standard.
 * Motion hooks: data-page (theme switch target, M2), data-motion="footer-reveal" on the footer (M3),
 *               data-wing-cover (butterfly wing transition: pages, anchors, full-page menu).
 */
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo, { type SeoProps } from './Seo.astro';
import FontLinks from './FontLinks.astro';
import Nav from './Nav.astro';
import CtaFooter from './CtaFooter.astro';
import { site } from '../../config/site';
import { ui } from '../../config/ui';

type Props = SeoProps;
const seo = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <!-- Pin cascade-layer order before any bundled stylesheet. -->
    <style is:inline>
      @layer reset, tokens, base, components, utilities;
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <FontLinks />
    <Seo {...seo}>
      <slot name="jsonld" slot="jsonld" />
    </Seo>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link type-label" href="#main">
      {ui.skipLink}
    </a>

    <div class="page" data-page>
      <Nav />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <CtaFooter />

    <!-- Butterfly wing transition cover (motion/wing.ts). Persists across swaps. -->
    <canvas class="wing-cover" data-wing-cover aria-hidden="true" hidden transition:persist="wing-cover"
    ></canvas>

    <script>
      import { bootMotion } from '../../motion';
      bootMotion();
    </script>
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: fixed;
      top: var(--space-8);
      left: var(--space-8);
      z-index: var(--z-skip);
      padding: var(--space-12) var(--space-16);
      background: var(--cta-bg);
      color: var(--cta-fg);
      border-radius: var(--radius-xs);
      transform: translateY(-200%);
    }
    .skip-link:focus-visible {
      transform: none;
    }

    .page {
      position: relative;
      z-index: var(--z-page);
      background-color: var(--page-bg);
      transition: background-color var(--dur-page) var(--ease-standard);
    }
    .page[data-page-theme='dark'] {
      background-color: var(--page-bg-dark);
    }
    /* M2: for one --dur-page after a theme flip, every colour on the page fades
       together (overrides component transitions only for that moment). */
    .page[data-theme-fading] :global(*) {
      transition-property:
        color, background-color, border-color, fill, stroke, box-shadow, filter !important;
      transition-duration: var(--dur-page) !important;
      transition-timing-function: var(--ease-standard) !important;
    }
    /* The page is a sheet that lifts off the sticky footer (brief M2/M6). */
    @media (min-width: 62rem) {
      .page {
        border-bottom-left-radius: var(--radius-md);
        border-bottom-right-radius: var(--radius-md);
      }
    }

    main:focus {
      outline: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .page {
        transition: none;
      }
    }

    /* M10: the pixel cover is the page transition, so the browser's own
       view-transition cross-fade is off. */
    :global(::view-transition-old(root)),
    :global(::view-transition-new(root)) {
      animation: none;
    }
    .wing-cover {
      position: fixed;
      inset: 0;
      z-index: var(--z-cover);
      width: 100vw;
      height: 100vh;
      pointer-events: none;
    }
    .wing-cover[hidden] {
      display: none;
    }
    @media (prefers-reduced-motion: reduce) {
      :global(::view-transition-group(*)),
      :global(::view-transition-old(*)),
      :global(::view-transition-new(*)) {
        animation: none !important;
      }
    }
  }
</style>
