---
/**
 * CtaFooter: the closing CTA + footer nav + logo (section "call").
 * Layout per brief §2.9 on the 12-column grid:
 *   top row    headline (largest type on the page) + Book a call, cols 1–4 (the
 *              headline's lines keep to one line each and run into the empty
 *              cols 5–8); cols 5–8 stay empty to separate the CTA from the links;
 *              four link columns (Studio, More, Culture, Social), one each in cols 9–12
 *   bottom row legal (mono) left; logo flush right, filling ~7 columns
 * Below lg everything stacks; the link columns sit two to a row.
 * Reveal (brief M6, decision 2026-09-29): from lg the footer is sticky at the
 * bottom behind the page (SiteShell's .page sits above it with rounded bottom
 * corners), so the page lifts off to reveal it. Below lg, or when the footer is
 * taller than the viewport, it stays in normal flow (data-footer-static).
 * Props: none (copy from src/config/ui.ts, links from src/config/navigation.ts).
 * Tokens: ink theme (--surface-page, --text-*), --section-py, --gutter,
 *         --text-closer, --tracking-closer, --leading-closer, --font-sans, --text-eyebrow, --tracking-eyebrow, --z-footer, --space-*.
 * Motion hooks: data-motion="footer-reveal" (M3).
 */
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import Grid12 from '../primitives/Grid12.astro';
import { bookCall, visibleFooterNav } from '../../config/navigation';
import { site } from '../../config/site';
import { ui } from '../../config/ui';
---

<footer
  id="call"
  class="footer"
  data-theme="ink"
  data-rain-scope
  data-motion="footer-reveal"
  transition:name="site-footer"
  transition:animate="none"
>
  <canvas class="footer__rain" data-rain aria-hidden="true"></canvas>
  <Grid12 class="footer__top">
    <div class="footer__cta">
      <h2 class="footer__heading">
        {ui.footer.headline.map((line) => <span class="footer__line">{line}</span>)}
      </h2>
      <Button href={bookCall.href} track={bookCall.track} cta data-rain-cta>
        {bookCall.label}
      </Button>
    </div>

    {visibleFooterNav.map((col, i) => {
      const headingId = `footer-${col.heading.toLowerCase()}`;
      return (
        <nav class:list={['footer__col', `footer__col--${i + 1}`]} aria-labelledby={headingId}>
          <p id={headingId} class="footer__col-heading">
            {col.heading}
          </p>
          <ul class="footer__links">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      );
    })}
  </Grid12>

  <Grid12 class="footer__bottom">
    <!-- Wordmark first so it sits on top when stacked (below lg); from lg both share row 1. -->
    <div class="footer__wordmark" data-logo-hover>
      <Logo class="footer__logo" />
    </div>
    <p class="footer__legal">
      © {new Date().getFullYear()} {site.legalName} · {site.address}
    </p>
  </Grid12>
</footer>

<script>
  // Keep the footer reachable: if it's taller than the viewport it can't be
  // pinned, so fall back to normal flow. Re-checked on resize.
  function initFooterReveal() {
    document
      .querySelectorAll<HTMLElement>('[data-motion="footer-reveal"]:not([data-footer-ready])')
      .forEach((footer) => {
        footer.dataset.footerReady = '';
        const check = () =>
          footer.toggleAttribute('data-footer-static', footer.offsetHeight > window.innerHeight);
        const observer = new ResizeObserver(check);
        observer.observe(footer);
        const controller = new AbortController();
        window.addEventListener('resize', check, { passive: true, signal: controller.signal });
        check();
        document.addEventListener(
          'astro:before-swap',
          () => {
            observer.disconnect();
            controller.abort();
          },
          { once: true },
        );
      });
  }

  initFooterReveal();
  document.addEventListener('astro:page-load', initFooterReveal);
</script>

<style>
  @layer components {
    .footer {
      position: relative;
      isolation: isolate;
      z-index: var(--z-footer);
      padding: var(--section-py) var(--gutter) var(--space-32);
      background: var(--surface-page);
      color: var(--text-primary);
    }

    .footer__top {
      row-gap: var(--space-48);
    }
    .footer__cta {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-32);
    }
    .footer__rain {
      position: absolute;
      inset: 0;
      z-index: var(--z-below);
      width: 100%;
      height: 100%;
      pointer-events: none;
    }
    .footer__heading {
      font-family: var(--font-display);
      font-weight: var(--weight-display);
      font-size: var(--text-closer);
      letter-spacing: var(--tracking-closer);
      line-height: var(--leading-closer);
    }
    .footer__line {
      display: block;
    }
    /* Each line stays on one line where it fits; phones let it wrap. */
    @media (min-width: 47.5rem) {
      .footer__line {
        white-space: nowrap;
      }
    }
    .footer__col {
      grid-column: span 6;
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
    }
    .footer__col-heading {
      font-family: var(--font-sans);
      font-weight: var(--weight-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
      font-size: var(--text-eyebrow);
      line-height: var(--leading-none);
      color: var(--text-secondary);
    }
    .footer__links {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      list-style: none;
      font-size: var(--text-body);
    }

    .footer__bottom {
      row-gap: var(--space-24);
      align-items: end;
      margin-top: var(--space-80);
    }
    .footer__legal {
      grid-column: 1 / -1;
      font-family: var(--font-sans);
      font-weight: var(--weight-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
      font-size: var(--text-eyebrow);
      line-height: var(--leading-none);
      color: var(--text-muted);
    }
    .footer__wordmark {
      grid-column: 1 / -1;
    }
    .footer__wordmark :global(.footer__logo) {
      width: 100%;
      height: auto;
    }

    @media (min-width: 62rem) {
      .footer:not([data-footer-static]) {
        position: sticky;
        bottom: 0;
      }
      .footer__cta {
        grid-column: 1 / span 4;
      }
      /* One column each from 9; the rest follow on the same row. */
      .footer__col {
        grid-column: span 1;
      }
      .footer__col--1 {
        grid-column: 9 / span 1;
      }
      .footer__legal {
        grid-column: 1 / span 5;
        grid-row: 1;
      }
      .footer__wordmark {
        grid-column: 6 / -1;
        grid-row: 1;
      }
    }
  }
</style>
