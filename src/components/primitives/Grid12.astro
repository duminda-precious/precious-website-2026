---
/**
 * Grid12: the one layout grid (brief §2.1). 12 equal columns at every width,
 * full width, no max-width. The side padding comes from Section (--gutter), so
 * the grid spans the viewport minus the gutters. Narrow text is made with
 * GridItem spans plus a measure, never with a wrapper.
 * Props: rowGap ('none' | 'grid' = --grid-gap-row | 'header' = --header-gap), as, class.
 * Tokens: --grid-columns, --grid-gap-col, --grid-gap-row, --header-gap.
 * Motion hooks: none.
 */
import type { HTMLTag } from 'astro/types';

interface Props {
  rowGap?: 'none' | 'grid' | 'header';
  as?: HTMLTag;
  class?: string;
  [key: string]: unknown;
}
const { rowGap = 'none', as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['grid12', `grid12--row-${rowGap}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  @layer components {
    .grid12 {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gap-col);
      align-items: start;
    }
    .grid12--row-grid {
      row-gap: var(--grid-gap-row);
    }
    .grid12--row-header {
      row-gap: var(--header-gap);
    }
  }
</style>
