---
/**
 * SectionHeader: the brief's three-zone header (§2.2) on one grid row.
 *   eyebrow (optional)  cols 1–3, mono uppercase
 *   statement            cols 4–9 with an eyebrow, 1–9 without; capped by measure
 *   action (optional)   cols 10–12, flush right, top-aligned
 * Below lg (992px) everything stacks full width, left-aligned (brief §7).
 * Props: headingId (for aria-labelledby on the Section), headingLevel (2 default),
 *        align ('start' default | 'center': one centred column, e.g. Team), class, any attribute.
 * Slots: eyebrow, default (statement text), sub (optional line under the statement),
 *        meta (optional element under that, e.g. a rating pill), action.
 * Tokens: --text-statement, --tracking-heading, --leading-heading, --measure-statement,
 *         --text-medium, --text-secondary, --text-eyebrow, --tracking-eyebrow, --header-gap, --space-*.
 */
import Grid12 from './Grid12.astro';

interface Props {
  headingId?: string;
  headingLevel?: 2 | 3;
  align?: 'start' | 'center';
  class?: string;
  [key: string]: unknown;
}
const { headingId, headingLevel = 2, align = 'start', class: className, ...rest } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const hasEyebrow = Astro.slots.has('eyebrow');
const hasSub = Astro.slots.has('sub');
const hasMeta = Astro.slots.has('meta');
const hasAction = Astro.slots.has('action');
---

<Grid12 class:list={['section-header', `section-header--${align}`, className]} {...rest}>
  {hasEyebrow && (
    <p class="section-header__eyebrow">
      <slot name="eyebrow" />
    </p>
  )}
  <div class:list={['section-header__main', { 'section-header__main--indented': hasEyebrow }]}>
    <Heading id={headingId} class="section-header__statement type-statement">
      <slot />
    </Heading>
    {hasSub && (
      <p class="section-header__sub type-subline">
        <slot name="sub" />
      </p>
    )}
    {hasMeta && (
      <div class="section-header__meta">
        <slot name="meta" />
      </div>
    )}
  </div>
  {hasAction && (
    <div class="section-header__action">
      <slot name="action" />
    </div>
  )}
</Grid12>

<style>
  @layer components {
    .section-header {
      row-gap: var(--space-24);
      margin-bottom: var(--header-gap);
    }
    /* :where keeps this at zero specificity so the lg placements below win. */
    :where(.section-header > *) {
      grid-column: 1 / -1;
    }
    .section-header__eyebrow {
      font-family: var(--font-sans);
      font-weight: var(--weight-eyebrow);
      letter-spacing: var(--tracking-eyebrow);
      font-size: var(--text-eyebrow);
      line-height: var(--leading-none);
    }
    .section-header__statement {
      max-width: var(--measure-statement);
    }
    .section-header__sub {
      margin-top: var(--space-12);
    }
    .section-header--center .section-header__main {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .section-header__meta {
      margin-top: var(--space-16);
    }
    @media (min-width: 62rem) {
      .section-header__eyebrow {
        grid-column: 1 / span 3;
      }
      .section-header__main {
        grid-column: 1 / span 9;
      }
      .section-header--center .section-header__main {
        grid-column: 1 / -1;
      }
      .section-header__main--indented {
        grid-column: 4 / span 6;
      }
      .section-header__action {
        grid-column: 10 / -1;
        justify-self: end;
        align-self: start;
      }
    }
  }
</style>
