---
/**
 * TypeSection (/brand 06): the two families and every type role.
 *   Families  specimen, fallback stack and the weights the site uses (--weight-* roles,
 *             each named after the scale step it points at, with its tokens.css note)
 *   Roles     each --text-* role set in its own style, with its size (fixed or fluid
 *             range), leading, tracking, family and weight, all read from tokens.css.
 * Which leading, tracking and weight each role uses mirrors base.css and the components
 * (the same pairing as /dev/tokens); the values themselves come from the tokens.
 * Props: type (brand.json → type), tagline (weight samples), ui.
 * Tokens: --font-display, --font-sans, --text-*, --leading-*, --tracking-*, --weight-*,
 *         --border-default, --border-strong, --text-secondary, --space-*.
 */
import BrandSection from './BrandSection.astro';
import Grid12 from '../primitives/Grid12.astro';
import GridItem from '../primitives/GridItem.astro';
import CopyValue from './CopyValue.astro';
import { token, resolve, reference, label, formatRange } from '../../lib/designTokens';
import type { Brand } from '../../lib/content';

interface Props {
  type: Brand['type'];
  tagline: string;
  ui: Brand['ui'];
}
const { type, tagline, ui } = Astro.props;

type Family = 'display' | 'sans';
const familyName = (f: Family) =>
  token(`font-family-${f}`).value.split(',')[0]!.replace(/['"]/g, '').trim();
const weight = (role: string) => {
  const t = token(`weight-${role}`);
  const step = reference(t.value);
  return {
    role,
    value: resolve(t.value),
    name: step ? label(step.replace(/^weight-/, '')) : '',
    note: t.note.replace(/^\.\.\.\s*|\s*\.\.\.$/g, ''),
  };
};
const families: { key: Family; roles: string[] }[] = [
  { key: 'display', roles: ['display', 'figure'] },
  { key: 'sans', roles: ['body', 'label'] },
];

// [role, family, weight, leading, tracking, uppercase?, italic?]
type Role = [string, Family, string, string, string, boolean?, boolean?];
const roles: Role[] = [
  ['hero', 'display', 'display', 'hero', 'hero'],
  ['closer', 'display', 'display', 'closer', 'closer'],
  ['h1', 'display', 'display', 'heading', 'heading'],
  ['menu', 'display', 'display', 'menu', 'heading'],
  ['statement', 'display', 'display', 'heading', 'heading'],
  ['figure', 'display', 'figure', 'closer', 'closer'],
  ['title', 'display', 'display', 'heading', 'title'],
  ['quote', 'sans', 'body', 'quote', 'body', false, true],
  ['large', 'sans', 'body', 'large', 'title'],
  ['note', 'sans', 'body', 'large', 'body'],
  ['medium', 'sans', 'body', 'medium', 'body'],
  ['body', 'sans', 'body', 'body', 'body'],
  ['small', 'sans', 'body', 'compact', 'body'],
  ['label', 'sans', 'label', 'none', 'label', true],
  ['eyebrow', 'sans', 'eyebrow', 'none', 'eyebrow'],
];
const roleRows = roles.map(([role, family, w, leading, tracking, upper, italic]) => ({
  role,
  sample: type.samples[role] ?? label(role),
  style: [
    `font-family: var(--font-${family})`,
    `font-size: var(--text-${role})`,
    `font-weight: var(--weight-${w})`,
    `line-height: var(--leading-${leading})`,
    `letter-spacing: var(--tracking-${tracking})`,
    upper ? 'text-transform: uppercase' : '',
    italic ? 'font-style: italic' : '',
  ]
    .filter(Boolean)
    .join('; '),
  spec: [
    formatRange(token(`text-${role}`).value),
    `${token(`leading-${leading}`).value} / ${token(`tracking-${tracking}`).value}`,
    `${familyName(family)} ${resolve(token(`weight-${w}`).value)}${italic ? ' italic' : ''}`,
  ],
}));
---

<BrandSection id="type" section={type}>
  <div class="type-sec">
    <Grid12 class="type-sec__families">
      {families.map((f) => (
        <GridItem span={6}>
          <div class="type-sec__family" style={`font-family: var(--font-${f.key})`}>
            <p class="type-sec__aa" aria-hidden="true">
              {type.glyph}
            </p>
            <div>
              <h3 class="type-sec__name">{familyName(f.key)}</h3>
              <p class="type-sec__meta">{type.families[f.key]}</p>
            </div>
            <div class="type-sec__specimen">
              {type.specimen.map((line) => (
                <p>{line}</p>
              ))}
            </div>
            <CopyValue value={token(`font-family-${f.key}`).value} label={ui.copyCss} />
            <div class="type-sec__weights">
              <p class="type-sec__meta">{type.weightsLabel}</p>
              {f.roles.map(weight).map((w) => (
                <div class="type-sec__weight">
                  <p class="type-sec__weight-sample" style={`font-weight: var(--weight-${w.role})`}>
                    {tagline}
                  </p>
                  <p class="type-sec__meta">
                    {w.name} · {w.value} · {w.note}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </GridItem>
      ))}
    </Grid12>

    <div class="type-sec__roles">
      <h3 class="type-sec__heading">{type.rolesLabel}</h3>
      {roleRows.map((r) => (
        <div class="type-sec__role">
          <div class="type-sec__role-name">
            <span>{label(r.role)}</span>
            <CopyValue value={`var(--text-${r.role})`} label={ui.copyToken}>
              --text-{r.role}
            </CopyValue>
          </div>
          <p class="type-sec__role-sample" style={r.style}>
            {r.sample}
          </p>
          <p class="type-sec__role-spec">
            {r.spec.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        </div>
      ))}
    </div>
  </div>
</BrandSection>

<style>
  @layer components {
    .type-sec {
      display: flex;
      flex-direction: column;
      gap: var(--space-80);
    }
    .type-sec__families {
      row-gap: var(--space-64);
    }
    .type-sec__family {
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
      padding-top: var(--space-16);
      border-top: var(--border-width) solid var(--border-strong);
    }
    .type-sec__aa {
      font-size: var(--text-hero);
      line-height: var(--leading-none);
      letter-spacing: var(--tracking-hero);
    }
    .type-sec__name {
      font-family: inherit;
      font-size: var(--text-statement);
      letter-spacing: var(--tracking-heading);
    }
    .type-sec__meta {
      font-family: var(--font-sans);
      font-size: var(--text-small);
      line-height: var(--leading-compact);
      color: var(--text-secondary);
    }
    .type-sec__specimen {
      font-size: var(--text-large);
      line-height: var(--leading-large);
      overflow-wrap: anywhere;
    }
    .type-sec__weights {
      display: flex;
      flex-direction: column;
      gap: var(--space-12);
    }
    .type-sec__weight {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-bottom: var(--space-12);
      border-bottom: var(--border-width) solid var(--border-default);
    }
    .type-sec__weight-sample {
      font-size: var(--text-title);
      line-height: var(--leading-heading);
      letter-spacing: var(--tracking-title);
    }
    .type-sec__roles {
      display: flex;
      flex-direction: column;
    }
    .type-sec__heading {
      padding-bottom: var(--space-16);
      font-size: var(--text-large);
      line-height: var(--leading-large);
      letter-spacing: var(--tracking-title);
      border-bottom: var(--border-width) solid var(--border-strong);
    }
    .type-sec__role {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8) var(--grid-gap-col);
      padding-block: var(--space-24);
      border-bottom: var(--border-width) solid var(--border-default);
    }
    .type-sec__role-name {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: var(--text-small);
      font-weight: var(--weight-label);
    }
    .type-sec__role-sample {
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .type-sec__role-spec {
      display: flex;
      flex-direction: column;
      font-size: var(--text-small);
      line-height: var(--leading-compact);
      color: var(--text-secondary);
    }
    @media (min-width: 62rem) {
      .type-sec__role {
        grid-template-columns: 2fr 7fr 3fr;
        align-items: baseline;
      }
    }
  }
</style>
