---
/**
 * ColourSection (/brand 04): every colour in tokens.css.
 *   Primitives  grouped as brand.json lists them (token prefixes after "color-"); each
 *               group's note is the tokens.css comment above it.
 *   Semantic    every token the light theme defines, with its value and source primitive
 *               for light, dark and ink (the header's theme switch swaps them).
 * Props: colour (brand.json → colour), ui.
 * Tokens: --text-large, --leading-large, --tracking-title, --text-small, --text-secondary,
 *         --weight-label, --border-strong, --space-*.
 */
import BrandSection from './BrandSection.astro';
import Swatch from './Swatch.astro';
import {
  tokensMatching,
  themeTokens,
  themeValue,
  themeNote,
  themeNames,
  resolve,
  reference,
  label,
  type Theme,
} from '../../lib/designTokens';
import type { Brand } from '../../lib/content';

interface Props {
  colour: Brand['colour'];
  ui: Brand['ui'];
}
const { colour, ui } = Astro.props;

const primitives = tokensMatching(/^color-/);
const groups = colour.groups.map((g) => {
  const tokens = primitives.filter((t) => {
    const key = t.name.replace(/^color-/, '');
    return g.tokens.some((p) => (p.endsWith('-') ? key.startsWith(p) : key === p));
  });
  return { title: g.title, note: tokens.find((t) => t.group)?.group, tokens };
});

const perTheme = (fn: (theme: Theme) => string) =>
  Object.fromEntries(themeNames.map((t) => [t, fn(t)])) as Record<Theme, string>;
const semantic = themeTokens('light').map((t) => ({
  token: t,
  values: perTheme((theme) => resolve(themeValue(t.name, theme) ?? '', theme)),
  refs: perTheme((theme) => {
    const ref = reference(themeValue(t.name, theme) ?? '');
    return ref ? label(ref.replace(/^color-/, '')) : '';
  }),
  notes: perTheme((theme) => themeNote(t.name, theme)),
}));
---

<BrandSection id="colour" section={colour}>
  <div class="colour">
    <h3 class="colour__heading">{colour.primitives}</h3>
    {groups.map((g) => (
      <div class="colour__group">
        <div class="colour__group-head">
          <h4 class="colour__group-title">{g.title}</h4>
          {g.note && <p class="colour__note">{g.note}</p>}
        </div>
        <div class="colour__swatches">
          {g.tokens.map((t) => (
            <Swatch
              name={t.name}
              title={label(t.name.replace(/^color-/, ''))}
              values={t.value}
              note={t.note}
              ui={ui}
            />
          ))}
        </div>
      </div>
    ))}

    <div class="colour__group-head">
      <h3 class="colour__heading">{colour.semantic.label}</h3>
      <p class="colour__note">{colour.semantic.text}</p>
    </div>
    <div class="colour__swatches">
      {semantic.map((s) => (
        <Swatch
          name={s.token.name}
          title={label(s.token.name)}
          values={s.values}
          refs={s.refs}
          note={s.notes}
          ui={ui}
        />
      ))}
    </div>
  </div>
</BrandSection>

<style>
  @layer components {
    .colour {
      display: flex;
      flex-direction: column;
      gap: var(--space-40);
    }
    .colour__heading {
      font-size: var(--text-large);
      line-height: var(--leading-large);
      letter-spacing: var(--tracking-title);
    }
    .colour__group {
      display: flex;
      flex-direction: column;
      gap: var(--space-16);
      padding-top: var(--space-16);
      border-top: var(--border-width) solid var(--border-strong);
    }
    .colour__group-head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .colour__group-title {
      font-size: var(--text-small);
      font-weight: var(--weight-label);
    }
    .colour__note {
      max-width: var(--measure-subline);
      font-size: var(--text-small);
      line-height: var(--leading-compact);
      color: var(--text-secondary);
    }
    .colour__swatches {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 9rem), 1fr));
      gap: var(--space-24) var(--grid-gap-col);
    }
  }
</style>
