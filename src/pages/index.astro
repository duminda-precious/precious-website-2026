---
/** Homepage: sections in prototype order; all copy from content files. */
import SiteShell from '../components/layout/SiteShell.astro';
import Hero from '../components/home/Hero.astro';
import ClientTicker from '../components/home/ClientTicker.astro';
import WorkSection from '../components/home/WorkSection.astro';
import ClientsSection from '../components/home/ClientsSection.astro';
import TeamSection from '../components/home/TeamSection.astro';
import ApproachSection from '../components/home/ApproachSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import JournalSection from '../components/home/JournalSection.astro';
import { getHome, getHomeWork, getTestimonials, getClients, getFaq } from '../lib/content';

const [home, work, testimonials, clients, faq] = await Promise.all([
  getHome(),
  getHomeWork(),
  getTestimonials(),
  getClients(),
  getFaq(),
]);
---

<SiteShell {...home.seo}>
  <Hero headline={home.hero.headline} reel={home.hero.reel} news={home.hero.news} />
  <ClientTicker clients={clients} />
  <WorkSection {...home.work} items={work} />
  <ClientsSection heading={home.clients.heading} testimonials={testimonials} />
  <TeamSection
    heading={home.team.heading}
    subline={home.team.subline}
    roles={[...home.team.coreRoles, ...home.team.extendedRoles]}
    engineLabel={home.team.engineLabel}
    engine={home.team.engine}
    benefits={home.team.benefits}
  />
  <ApproachSection {...home.approach} />
  <ProcessSection {...home.process} />
  <FaqSection heading={home.faq.heading} items={faq} />
  <JournalSection {...home.journal} />
</SiteShell>
