const semantic = [
  'surface-page',
  'surface-raised',
  'surface-muted',
  'surface-inverse',
  'text-primary',
  'text-secondary',
  'text-tertiary',
  'text-muted',
  'text-on-inverse',
  'text-strong',
  'border-subtle',
  'border-default',
  'border-strong',
  'accent',
  'cta-bg',
  'cta-fg',
  'cta-accent-bg',
  'cta-accent-fg',
  'focus-ring',
  'tag-border',
  'placeholder-stripe-a',
  'placeholder-stripe-b',
  'placeholder-fg',
];

// [foreground, background, label, size hint]; "large" = ≥24px or ≥18.66px bold
const contrastPairs: [string, string, string, 'normal' | 'large'][] = [
  ['text-primary', 'surface-page', 'Body text', 'normal'],
  ['text-secondary', 'surface-page', 'Secondary text (FAQ answers, sublines)', 'normal'],
  ['text-tertiary', 'surface-page', 'Tertiary text (team subline)', 'normal'],
  ['text-muted', 'surface-raised', 'Quote role on card', 'normal'],
