  ['ui', 'View case study', 'var(--leading-body)', 'var(--tracking-normal)'],
  ['caption', 'Work · Approach · Clients · FAQ', 'var(--leading-body)', 'var(--tracking-normal)'],
  ['micro', '© Precious Studio · Austin, TX', 'var(--leading-body)', 'var(--tracking-normal)'],
  ['label', 'EXTEND MY TEAM', 'var(--leading-body)', 'var(--tracking-label)'],
