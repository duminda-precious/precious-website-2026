---
/**
 * /dev/tokens: the whole design system on one page, for building and for
 * verifying the phase-2 rebrand. Dev-only (noindex, not in sitemap).
 * Copy on this page is reference/sample text, not site content.
 */
import DevLayout from '../../layouts/DevLayout.astro';
import Container from '../../components/primitives/Container.astro';
import Section from '../../components/primitives/Section.astro';
import Grid12 from '../../components/primitives/Grid12.astro';
import GridItem from '../../components/primitives/GridItem.astro';
import Stack from '../../components/primitives/Stack.astro';
import Cluster from '../../components/primitives/Cluster.astro';
import Button from '../../components/ui/Button.astro';
import TextLink from '../../components/ui/TextLink.astro';
import Tag from '../../components/ui/Tag.astro';
import Pill from '../../components/ui/Pill.astro';
import MediaFrame from '../../components/ui/MediaFrame.astro';

const primitives = {
  Neutrals: [
    'white',
    'grey-25',
    'grey-50',
    'grey-75',
    'grey-100',
    'grey-125',
    'grey-150',
    'grey-175',
    'grey-200',
    'grey-300',
    'grey-350',
    'grey-400',
    'grey-450',
    'grey-500',
    'grey-550',
    'grey-600',
    'grey-650',
    'grey-800',
    'ink-900',
    'ink-950',
    'black',
  ],
  Maroon: [
    'maroon-50',
    'maroon-300',
    'maroon-500',
    'maroon-700',
    'maroon-850',
    'maroon-900',
    'maroon-950',
  ],
  Forest: ['forest-50', 'forest-300', 'forest-400', 'forest-800', 'forest-850', 'forest-900'],
  Accents: ['orange-500', 'lime-300', 'olive-800', 'stone-50'],
