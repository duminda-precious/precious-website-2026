  ['cta-accent-fg', 'cta-accent-bg', 'Accent button', 'normal'],
  ['accent', 'surface-page', 'Accent on page (FAQ +)', 'large'],
  ['placeholder-fg', 'placeholder-stripe-a', 'Placeholder label', 'normal'],
  ['gate-1-fg', 'gate-1-bg', 'Gate 1 title', 'large'],
  ['gate-1-pain', 'gate-1-bg', 'Gate 1 pain line', 'normal'],
  ['gate-2-fg', 'gate-2-bg', 'Gate 2 title', 'large'],
